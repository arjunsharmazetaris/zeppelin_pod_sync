    {
      "text": "%spark.ipyspark\n\nspark.conf.set(\"fs.azure.account.key.zetarisgenzstorage.blob.core.windows.net\", \"qG9NdPf1UjqzsDB09SKNDPhwGsUv44hSuzhPsqtBkzs1RPMnqQFv4bgtD6mBcjtj8UcHivXsnGNr+AStUiQsfg\u003d\u003d\")\n\nimport requests\nimport logging\nimport pandas as pd\nimport json\nimport uuid\nfrom base64 import b64encode\nimport base64\nimport time\n#from ZetarisAPI import *\nimport os\nimport openai\nfrom langchain.chains import ConversationalRetrievalChain\nfrom langchain.chat_models import ChatOpenAI\nfrom langchain.agents.agent_types import AgentType\nfrom langchain.embeddings import OpenAIEmbeddings, HuggingFaceInstructEmbeddings\nfrom langchain.llms import OpenAI\nfrom langchain.chains import RetrievalQA\nfrom langchain.vectorstores import Chroma\nfrom langchain.document_loaders import JSONLoader,CSVLoader\nfrom langchain.text_splitter import CharacterTextSplitter\nfrom langchain.vectorstores import FAISS\nfrom langchain import PromptTemplate, LLMChain\nfrom langchain.retrievers.multi_query import MultiQueryRetriever\nfrom langchain.chains.question_answering import load_qa_chain\nfrom langchain.callbacks import get_openai_callback\n#from langchain.agents import create_pandas_dataframe_agent\nfrom langchain.text_splitter import RecursiveCharacterTextSplitter\nfrom langchain.document_loaders import DirectoryLoader\n#from langchain.agents import create_csv_agent\nfrom langchain.memory import ConversationBufferMemory\nfrom langchain.llms import HuggingFaceHub\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import List\nfrom langchain.chains import LLMChain\nfrom langchain_community.document_loaders import AzureBlobStorageContainerLoader\nfrom pydantic import BaseModel, Field\nfrom langchain.prompts import PromptTemplate\nfrom langchain.output_parsers import PydanticOutputParser\n#from langchain_openai import OpenAIEmbeddings\nfrom langchain.chains import TransformChain\nfrom langchain.chains import SequentialChain\nimport csv\nimport re\nfrom langchain.retrievers import ParentDocumentRetriever\nfrom langchain.storage import InMemoryStore\nimport shutil\nfrom azure.storage.blob import BlobServiceClient\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Adding the OPENAI KEY in the Environment\n\nos.environ[\"OPENAI_API_KEY\"] \u003d \"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\"\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Delete Azure Blob container\ndef delete_container_if_exists(blob_service_client, container_name):\n    try:\n        if blob_service_client.get_container_client(container_name).exists():\n            blob_service_client.delete_container(container_name)\n            print(f\"Container \u0027{container_name}\u0027 deleted successfully\")\n        else:\n            print(f\"Container \u0027{container_name}\u0027 does not exist\")\n\n    except Exception as e:\n        print(f\"An error occurred while deleting the container: {str(e)}\")\n        \n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Create Blob Container\ndef create_container(blob_service_client, container_name):\n    try:\n        blob_service_client.create_container(container_name)\n        print(f\"Container \u0027{container_name}\u0027 created successfully\")\n    except Exception as e:\n        print(f\"An error occurred while creating the container: {str(e)}\")\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Get the result in string or list format and convert it to a dataframe with desired columns\ndef generate_result_dataframe(retres):\n    lines \u003d retres.split(\u0027\\n\u0027)\n    project_names \u003d []\n    categories \u003d []\n    for line in lines:\n        parts \u003d line.split(\u0027:\u0027)\n        project_name \u003d parts[0].strip()\n        categories_str \u003d parts[1].strip()\n        if \u0027,\u0027 in categories_str:\n            categories_list \u003d categories_str.split(\u0027,\u0027)\n            for category in categories_list:\n                project_names.append(project_name)\n                categories.append(category.strip())\n        else:\n            project_names.append(project_name)\n            categories.append(categories_str)\n    df \u003d pd.DataFrame({\u0027Project_Name\u0027: project_names, \u0027Capability_Name\u0027: categories})\n    return df\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#As per the given data, map the appropriate project and capability id with the respective names\ndef find_relevant_id(prj_cap_name,p_or_c,df_project_ids,df_capability_ids):\n    cleaned_name \u003d prj_cap_name.strip().split(\u0027:\u0027)[0].strip().lower()\n    if p_or_c.strip().lower()\u003d\u003d\u0027project\u0027:\n        matching_row \u003d df_project_ids[df_project_ids[\u0027Project_Name\u0027].str.strip().str.lower() \u003d\u003d cleaned_name]\n    else:\n        matching_row \u003d df_capability_ids[df_capability_ids[\u0027Capability_Name\u0027].str.strip().str.lower() \u003d\u003d cleaned_name]\n    if not matching_row.empty:\n        if p_or_c.strip().lower()\u003d\u003d\u0027project\u0027:\n            return matching_row.iloc[0][\u0027project_id\u0027]\n        else:\n            return matching_row.iloc[0][\u0027capability_id\u0027]\n    else:\n        return None\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Connect to Azure Blob Storage account and create container (if it exists, delete it first)\ndef connect_to_container(connection_string, container_name):\n    try:\n        blob_service_client \u003d BlobServiceClient.from_connection_string(connection_string)\n        delete_container_if_exists(blob_service_client, container_name)\n        time.sleep(60)\n        create_container(blob_service_client, container_name)\n        container_client \u003d blob_service_client.get_container_client(container_name)\n        return container_client\n\n    except Exception as e:\n        print(f\"An error occurred while connecting to the container: {str(e)}\")\n        return None\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Get the relevant data mart tables and store the relevant data as csv or json\ndef process_selected_dm_tables(connection_string,container_name):\n    container_client \u003d connect_to_container(connection_string, container_name)\n    dmfull\u003d\"Gravity_Datamart\"\n    dmtables\u003d[\u0027Projects_AWS\u0027,\u0027Capabilities_AWS\u0027]\n    try:\n        create_container(blob_service_client, container_name)        \n        for table in dmtables:\n            csv_filename \u003d f\"{dmfull}_{table}.csv\"\n            select_query_initial \u003d f\"Select * from {dmfull}.{table}\"\n            csv_path \u003d f\"wasbs://{container_name}@{connection_string}.blob.core.windows.net/{csv_filename}\"\n            print(csv_path)\n            df \u003d spark.sql(select_query_initial.lower())\n            df.show()\n            df.write.csv(csv_path, header\u003dTrue)  # Specify header\n        return \u0027Process completed successfully\u0027\n    except Exception as e:\n        return f\"An error occurred: {str(e)}\"\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Get the result in string or list format and convert it to a dataframe with desired columns\ndef generate_result_dataframe(retres):\n    lines \u003d retres.split(\u0027\\n\u0027)\n    project_names \u003d []\n    categories \u003d []\n    for line in lines:\n        parts \u003d line.split(\u0027:\u0027)\n        project_name \u003d parts[0].strip()\n        categories_str \u003d parts[1].strip()\n        if \u0027,\u0027 in categories_str:\n            categories_list \u003d categories_str.split(\u0027,\u0027)\n            for category in categories_list:\n                project_names.append(project_name)\n                categories.append(category.strip())\n        else:\n            project_names.append(project_name)\n            categories.append(categories_str)\n    df \u003d pd.DataFrame({\u0027Project_Name\u0027: project_names, \u0027Capability_Name\u0027: categories})\n    return df\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Use the data stored in the directory above and process the data and create embeddings and result for the user as per the supplied question\ndef process_question_function(container_name, connection_string, question):\n    loader \u003d AzureBlobStorageContainerLoader(conn_str\u003dconnection_string, container\u003dcontainer_name)\n    data \u003d loader.load()\n    print(data)\n    \n    # This text splitter is used to create the parent documents\n    parent_splitter \u003d RecursiveCharacterTextSplitter(chunk_size\u003d1000000)\n    \n    # This text splitter is used to create the child documents\n    # It should create documents smaller than the parent\n    child_splitter \u003d RecursiveCharacterTextSplitter(chunk_size\u003d1000)\n    \n    # The vectorstore to use to index the child chunks\n    vectorstore \u003d Chroma(collection_name\u003d\"return_split_parent_documents\", embedding_function\u003dOpenAIEmbeddings())\n    \n    # The storage layer for the parent documents\n    store \u003d InMemoryStore()\n\n    #This will set up our retriever for us\n    retriever \u003d ParentDocumentRetriever(\n        vectorstore\u003dvectorstore, \n        docstore\u003dstore, \n        child_splitter\u003dchild_splitter,\n        parent_splitter\u003dparent_splitter,\n    )\n    \n    #Both of them will be combined.\n    retriever.add_documents(data)\n    \n    #Let\u0027s check out how many documents we have now\n    print(\u0027Documents Length\u0027)\n    print(len(list(store.yield_keys())))\n    llm \u003d ChatOpenAI(temperature\u003d0, model\u003d\u0027gpt-4\u0027)\n    larger_chunk_relevant_docs \u003d retriever.get_relevant_documents(question)\n\n    print(larger_chunk_relevant_docs)\n\n    prompt_template \u003d \"\"\"Use the following pieces of context to answer the question at the end.\n                        If you don\u0027t know the answer, just say that you don\u0027t know, don\u0027t try to make up an answer.\n                        \n                        {context}\n                        \n                        Question: {question}\n                        Answer:\"\"\"\n    \n    PROMPT \u003d PromptTemplate(\n        template\u003dprompt_template, input_variables\u003d[\"context\", \"question\"]\n    )\n                    \n    result \u003d llm.predict(text\u003dPROMPT.format_prompt(\n        context\u003dlarger_chunk_relevant_docs,\n        question\u003dquestion\n    ).text)\n\n    return(result)",
