      "text": "%spark.ipyspark\n\n#Call the process datamart function and fetch the data\n\nconnection_string \u003d \"DefaultEndpointsProtocol\u003dhttps;AccountName\u003dzetarisgenzstorage;AccountKey\u003dqG9NdPf1UjqzsDB09SKNDPhwGsUv44hSuzhPsqtBkzs1RPMnqQFv4bgtD6mBcjtj8UcHivXsnGNr+AStUiQsfg\u003d\u003d;EndpointSuffix\u003dcore.windows.net\"\ncontainer_name \u003d \"zetarisgenzstorage\"\nprocess_selected_dm_tables(connection_string,container_name)\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Fetch the generated data files and store it as pandas dataframes\n\ndf_project_ids \u003d spark.sql(\u0027select * from ProjectManagementDM.projects\u0027)\ndf_capability_ids \u003d spark.sql(\u0027select * from ProjectManagementDM.capabilities\u0027)\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Ask the required question and fetch the result suing OpenAI\nretres \u003d process_question_function(container_name, connection_string, \u0027Provide insights about suitable capabilities matching the project descriptions and assign a suitable capability . Give the response in this format (Project Name: Capability Name 1, Capability Name 2 and if there are more go ahead similarly.). One project may have one or more capabilities. Do not assign three capabilities to each project just because I gave in the example.\u0027)\nprint(retres)\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#\n\n#Convert the generated result into a dataframe\n\ndf_project_capability \u003d generate_result_dataframe(retres)\ndf_project_capability[\u0027Project_ID\u0027] \u003d df_project_capability.apply(lambda row: find_relevant_id(row[\u0027Project_Name\u0027], \u0027project\u0027, df_project_ids, df_capability_ids), axis\u003d1)\ndf_project_capability[\u0027Capability_ID\u0027] \u003d df_project_capability.apply(lambda row: find_relevant_id(row[\u0027Capability_Name\u0027], \u0027capability\u0027, df_project_ids, df_capability_ids), axis\u003d1)\n\n#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------#",
