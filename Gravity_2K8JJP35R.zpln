      "text": "def process_selected_dm_tables(apiurl, username, password):\n    container_name\u003d\u0027zetarisgenzstorage\u0027\n    \n    dmfull\u003d\"ProjectManagementDM\"\n    dmtables\u003d[\u0027projects\u0027,\u0027capabilities\u0027]\n    try:\n        set_api_base_url(apiurl)\n        login(username, password)\n        for table in dmtables:\n            select_query_initial \u003d f\"SELECT * FROM {dmfull}.{table}\"\n            csv_filename \u003d f\"{dmfull}_{table}.csv\"\n            print(\u0027Printing Select Query\u0027)\n            print(select_query_initial)  \n            data_zetaris \u003d SelectQuery(select_query_initial)\n            updated_data \u003d {\u0027data\u0027: data_zetaris}\n            df \u003d pd.DataFrame(updated_data)\n            df.to_csv(f\"abfs://{container_name}@{container_name}.dfs.core.windows.net/{csv_filename}\",storage_options \u003d {\u0027account_key\u0027 : \u0027qG9NdPf1UjqzsDB09SKNDPhwGsUv44hSuzhPsqtBkzs1RPMnqQFv4bgtD6mBcjtj8UcHivXsnGNr+AStUiQsfg\u003d\u003d\u0027})\n        return \u0027Process completed successfully\u0027\n\n    except Exception as e:\n        return f\"An error occurred: {str(e)}\"",
