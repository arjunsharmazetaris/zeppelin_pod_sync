    {
      "text": "import json\nimport csv\nfrom hl7apy.parser import parse_message\n\n\ndef split_hl7_messages(hl7_message):\n    \"\"\"\n    Splits an HL7 file into individual messages based on \u0027MSH\u0027.\n\n    :param file_path: Path to the HL7 file containing multiple messages.\n    :return: List of individual HL7 messages as strings.\n    \"\"\"\n    #with open(file_path, \u0027r\u0027) as file:\n       # hl7_data \u003d file.read()\n\n    hl7_data \u003d hl7_message\n    # Split messages using \u0027MSH\u0027 as the starting delimiter\n    messages \u003d hl7_data.split(\u0027\\nMSH\u0027)\n    messages \u003d [f\u0027MSH{msg}\u0027 if not msg.startswith(\u0027MSH\u0027) else msg for msg in messages]\n\n    return messages\n\n\ndef hl7_message_to_json(hl7_message):\n    \"\"\"\n    Converts a single HL7 message to JSON format.\n\n    :param hl7_message: Raw HL7 message string.\n    :return: JSON object representing the HL7 message.\n    \"\"\"\n    hl7_message \u003d hl7_message.replace(\"\\n\", \"\\r\")  # Ensure proper HL7 line endings\n    parsed_message \u003d parse_message(hl7_message)\n    return flatten_json(parse_hl7_to_dict(parsed_message))\n\n\ndef parse_hl7_to_dict(parsed_message):\n    \"\"\"\n    Converts a parsed HL7 message to a dictionary.\n\n    :param parsed_message: Parsed HL7 message from hl7apy.\n    :return: Dictionary representation of the message.\n    \"\"\"\n    if not parsed_message.children:\n        return parsed_message.to_er7()\n\n    result \u003d {}\n    for child in parsed_message.children:\n        name \u003d child.name.lower()\n        if child.long_name:\n            name \u003d child.long_name.lower()\n        child_value \u003d parse_hl7_to_dict(child)\n        if name in result:\n            if not isinstance(result[name], list):\n                result[name] \u003d [result[name]]\n            result[name].append(child_value)\n        else:\n            result[name] \u003d child_value\n    return result\n\n\ndef flatten_json(json_obj, parent_key\u003d\u0027\u0027, sep\u003d\u0027_\u0027):\n    \"\"\"\n    Flattens a nested JSON object.\n\n    :param json_obj: JSON object to flatten.\n    :param parent_key: Key under which nested elements are grouped.\n    :param sep: Separator for nested keys.\n    :return: A flattened JSON object.\n    \"\"\"\n    items \u003d []\n\n    def _flatten(obj, key_prefix\u003d\u0027\u0027):\n        if isinstance(obj, dict):\n            for k, v in obj.items():\n                new_key \u003d f\"{key_prefix}{sep}{k}\" if key_prefix else k\n                _flatten(v, new_key)\n        elif isinstance(obj, list):\n            for i, item in enumerate(obj):\n                _flatten(item, f\"{key_prefix}{sep}{i}\" if key_prefix else str(i))\n        else:\n            flat_dict[key_prefix] \u003d obj\n\n    flat_dict \u003d {}\n    _flatten(json_obj)\n    items.append(flat_dict)\n    return flat_dict\n\n\ndef write_csv(messages, output_csv_path):\n    \"\"\"\n    Writes multiple HL7 messages (in JSON format) to a CSV file.\n\n    :param messages: List of flattened JSON objects.\n    :param output_csv_path: Path to the output CSV file.\n    \"\"\"\n  # Write flattened data to a CSV file\n    # Create a DataFrame\n    flattened_data_df \u003d pd.DataFrame(messages)\n\n    # Convert the DataFrame to CSV in memory\n    csv_buffer \u003d BytesIO()\n    flattened_data_df.to_csv(csv_buffer, index\u003dFalse)\n    csv_buffer.seek(0)\n\n    connection_string \u003d \"DefaultEndpointsProtocol\u003dhttps;AccountName\u003dztdevsaasstacc;AccountKey\u003dASVqA3JusHezx4h/ltZG99Kn6DTjM8JwdnvreeViBBkZNE0sic7PP0IJ/1zqLvk/HGS+RQ1NKJxx+AStovQbug\u003d\u003d;EndpointSuffix\u003dcore.windows.net\"\n    share_name \u003d \"cusdatashare\"\n    folder_path \u003d \"7cd07542/file-store/Health\"\n    file_name \u003d \"hl7.csv\"\n\n    # Create a ShareServiceClient\n    service_client \u003d ShareServiceClient.from_connection_string(connection_string)\n\n    # Get a ShareClient for the file share\n    share_client \u003d service_client.get_share_client(share_name)\n\n    # Get a ShareFileClient for the specific file\n    file_client \u003d share_client.get_file_client(f\"{folder_path}/{file_name}\")\n\n    # Upload the CSV buffer to the file share\n    csv_buffer.seek(0)  # Reset the buffer position to the beginning\n    file_client.upload_file(csv_buffer.read())\n\n    print(f\"CSV file has been saved to {output_csv_path}\")\n\ndef extract_pdf_from_hl7(hl7_string):\n    \"\"\"\n    Extracts a Base64-encoded PDF from an HL7 file and saves it as a PDF file.\n\n    :param file_path: Path to the HL7 file.\n    :param output_pdf_path: Path to save the decoded PDF.\n    \"\"\"\n    try:\n        hl7_string \u003d hl7_string.replace(\"\\n\", \"\\r\")\n        # Read the HL7 file\n\n        # Parse the HL7 message\n        hl7_data \u003dhl7_string\n        hl7_message \u003d parse_message(hl7_data)\n\n        # Look for the OBX segment containing the Base64-encoded PDF\n        for segment in hl7_message.children:\n            if segment.name \u003d\u003d \"OBX\":\n                # Check if the OBX.5 field contains encoded PDF data\n                if segment[\u0027OBX.5\u0027][4].value \u003d\u003d \"Base64\":\n                    encoded_pdf \u003d segment[\u0027OBX.5\u0027][5].value\n                    if encoded_pdf:\n                        # Decode the Base64-encoded data\n                        pdf_data \u003d base64.b64decode(encoded_pdf)\n                        print(pdf_data)\n\n                        # Save the PDF to a file\n                        #with open(output_pdf_path, \u0027wb\u0027) as pdf_file:\n                            #pdf_file.write(pdf_data)\n\n                        print(f\"PDF successfully extracted and saved to {output_pdf_path}\")\n                        return\n        print(\"No Base64-encoded PDF found in the HL7 file.\")\n    except Exception as e:\n        print(f\"An error occurred: {e}\")\n\n\n# Main function to process the HL7 file\nif __name__ \u003d\u003d \"__main__\":\n    input_hl7_file \u003d \"/mnt/data/HL7_with_pdf.txt\"  # Replace with your HL7 file path\n    output_csv_file \u003d \"hl7_messages.csv\"\n    hl7_sample_message \u003d \"\"\"MSH|^~\\\u0026|HealthLink Portal 5.3|phallref||mherefer|20241027224704.0000+1100|PKI|REF^I12|MH-398535|P|2.3.1\nRF1|P^Pending^HL70283|S^STAT^HL70280|MED^Medical^HL70281|AM^Assume Management^HL70282||MH-398535|20241027224704.0000+1100||||MH-398535\nPRD|RP^Referring Provider^HL70286|Collins^Catherine|294 Huntingdale Road^^Mount Waverley^Victoria^3149||+61 04 38306952^WPN^PH^^^^^^+61 04 38306952~^NET^Internet^catherine.c@beheardspeechpathology.com.au||11763^^AUSHICPR\nPRD|RT^Referred-To Provider^HL70286\nPID|||3589198543^^^AUSHIC^MC||Southern^Jaden||20080324|M|||6 Haddington Way^^Cranbourne^Victoria^3977^^H~6 Haddington Way^^Cranbourne^Victoria^3977^^M||^ORN^CP^^^^410848182~^ORN^PH^^^^410848182~jocelyne.desiree48@gmail.com^NET^Internet^^^^^^jocelyne.desiree48@gmail.com\nOBR|1|MH-398535|MH-398535|173386007^Referral to Cleft and Facial Anomalies - Paediatrics^SCT^MCH^Monash Children\u0027s Hospital^L||20241027224704.0000+1100|20241027224704.0000+1100|||||||||11763^Collins^Catherine^^^^^^AUSHICPR||||||||PHY|F||^^^20241027224704.0000+1100\nMSH|^~\\\u0026|HealthLink Portal 5.3|phallref||mherefer|20241027224704.0000+1100|PKI|REF^I12|MH-398535|P|2.3.1\nRF1|P^Pending^HL70283|S^STAT^HL70280|MED^Medical^HL70281|AM^Assume Management^HL70282||MH-398535|20241027224704.0000+1100||||MH-398535\nPRD|RP^Referring Provider^HL70286|Collins^Catherine|294 Huntingdale Road^^Mount Waverley^Victoria^3149||+61 04 38306952^WPN^PH^^^^^^+61 04 38306952~^NET^Internet^catherine.c@beheardspeechpathology.com.au||11763^^AUSHICPR\nPRD|RT^Referred-To Provider^HL70286\nPID|||3589198543^^^AUSHIC^MC||Southern^Jaden||20080324|M|||6 Haddington Way^^Cranbourne^Victoria^3977^^H~6 Haddington Way^^Cranbourne^Victoria^3977^^M||^ORN^CP^^^^410848182~^ORN^PH^^^^410848182~jocelyne.desiree48@gmail.com^NET^Internet^^^^^^jocelyne.desiree48@gmail.com\nOBR|1|MH-398535|MH-398535|173386007^Referral to Cleft and Facial Anomalies - Paediatrics^SCT^MCH^Monash Children\u0027s Hospital^L||20241027224704.0000+1100|20241027224704.0000+1100|||||||||11763^Collins^Catherine^^^^^^AUSHICPR||||||||PHY|F||^^^20241027224704.0000+1100\n\"\"\"\n  \n\n    # Step 1: Split the file into individual HL7 messages\n    hl7_messages \u003d split_hl7_messages(hl7_sample_message)\n\n    # Step 2: Convert each message to JSON and flatten it\n    flattened_messages \u003d []\n    for hl7_message in hl7_messages:\n        try:\n            flattened_message \u003d hl7_message_to_json(hl7_message)\n            flattened_messages.append(flattened_message)\n            extract_pdf_from_hl7(hl7_message)\n            print(flattened_message)\n        except Exception as e:\n            print(f\"Error parsing message: {e}\")\n\n    # Step 3: Write all messages to a CSV file\n    if flattened_messages:\n        print(\"writing\")\n        write_csv(flattened_messages, output_csv_file)\n",
