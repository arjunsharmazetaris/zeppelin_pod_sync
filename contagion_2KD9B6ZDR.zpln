    {
      "text": "%spark.ipyspark\n\n# common conditions across dataset\nconditions \u003d spark_conditions_df.toPandas()\n# Extract the descriptions and create a histogram\nconditions \u003d conditions[\u0027description\u0027].dropna()  # Remove rows with missing descriptions\ndescription_counts \u003d conditions.value_counts().head(10)\n\n# Print the bar chart using text-based representation\nprint(\"Most common Medical Conditions:\")\nfor condition, count in description_counts.items():\n  bar_length \u003d int(count / description_counts.max() * 50)  # Adjust scaling as needed\n  bar_char \u003d \u0027*\u0027 * bar_length\n  print(f\"{condition}: {bar_char} ({count})\")",
