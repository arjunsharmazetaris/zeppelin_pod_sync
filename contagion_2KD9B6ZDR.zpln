      "text": "%spark.ipyspark\n\nimport pandas as pd\nimport ipywidgets as widgets\n\n\n# common conditions across dataset\nconditions \u003d spark_conditions_df.toPandas()\n\n# Extract the top n descriptions\nn \u003d 10\ntopn_descriptions \u003d conditions.value_counts().head(n).index.tolist()\n\n# Create a dropdown widget\ndropdown \u003d widgets.Dropdown(\n    options\u003dtopn_descriptions,\n    value\u003dtopn_descriptions[0],  # Set the default value\n    description\u003d\u0027Select Condition:\u0027,\n    disabled\u003dFalse,\n)\n\ndef on_change(change):\n  if change[\u0027type\u0027] \u003d\u003d \u0027change\u0027 and change[\u0027name\u0027] \u003d\u003d \u0027value\u0027:\n    print(f\"Selected value: {change[\u0027new\u0027]}\")\n\ndropdown.observe(on_change)\n\n# Display the dropdown\ndisplay(dropdown)",
