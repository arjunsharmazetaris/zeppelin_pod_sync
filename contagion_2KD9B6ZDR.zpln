    {
      "text": "%spark.ipyspark\n\nimport seaborn as sns\nimport matplotlib\nmatplotlib.use(\u0027Agg\u0027)\nimport matplotlib.pyplot as plt\n\n# common conditions across dataset\nconditions \u003d spark_conditions_df.toPandas()\n\n# Extract the descriptions and create a histogram\nconditions \u003d conditions[\u0027description\u0027].dropna()  # Remove rows with missing descriptions\ndescription_counts \u003d conditions.value_counts().head(10)\n\nplt.figure(figsize\u003d(10, 6))  # Adjust figure size as needed\nplt.bar(description_counts.index, description_counts.values)\nplt.xlabel(\u0027Medical Condition\u0027)\nplt.ylabel(\u0027Number of Patients\u0027)\nplt.title(\u0027Histogram of Medical Conditions\u0027)\nplt.xticks(rotation\u003d90)  # Rotate x-axis labels for better readability if needed\nplt.tight_layout()  # Adjust layout for better spacing\nplt.show()",
      "user": "HEALTHCARE@ZETARIS.COM",
