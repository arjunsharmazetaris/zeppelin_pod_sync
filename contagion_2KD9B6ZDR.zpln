    {
      "text": "%spark.ipyspark\n\n# Identify geographic areas of concern where significant outbreaks are imminent\n\nconditions \u003d spark_conditions_df.toPandas()\npatients \u003d spark_patients_df.toPandas()\n\n\n# Merge the patients and conditions dataframes on the patient ID\nmerged_df \u003d pd.merge(patients, conditions, left_on\u003d\u0027patientid\u0027, right_on\u003d\u0027patient\u0027, how\u003d\u0027inner\u0027)\n\n# Filter the dataframe to include only patients with the specific condition\nviral_sinusitis_patients \u003d merged_df[merged_df[\u0027description\u0027] \u003d\u003d \u0027Viral sinusitis (disorder)\u0027]\n\n# Create a list of latitude and longitude coordinates for the heatmap\nheatmap_data \u003d viral_sinusitis_patients[[\u0027lat\u0027, \u0027lon\u0027]].values.tolist()\n\n# Create a folium map centered around the mean latitude and longitude\nmap_center_lat \u003d patients[\u0027lat\u0027].mean()\nmap_center_lon \u003d patients[\u0027lon\u0027].mean()\nr1_map \u003d folium.Map(location\u003d[map_center_lat, map_center_lon], zoom_start\u003d10)\n\n# Add a heatmap layer to the map\nHeatMap(heatmap_data, radius\u003d15).add_to(r1_map)\n\n# Display the map\nr1_map",
