    {
      "text": "SQL_QUERY \u003d \"\"\"\nSELECT dm_year, dm_month, day, time_cat, time_num, time_cos, time_sin, \n       day_cat, day_num, day_cos, day_sin, weekend, geohash, pickups\nFROM NYC_TAXI.GYT_PICKUPS\nWHERE dm_year\u003d%d AND dm_month\u003d%d AND td_year\u003d%d AND td_month\u003d%d\n\"\"\"\n\nfor ym in YEAR_MONTH:\n    yr \u003d ym[0]\n    mo \u003d ym[1]\n    print(str(yr) + \"-\" + str(mo))\n\n    SQL \u003d SQL_QUERY % (yr, mo, yr, mo)\n\n    df \u003d pd.io.sql.read_sql(SQL, conn)\n    print(df, end\u003d\u0027\u0027)\n    print(df.shape)\n\n    header \u003d False\n    if (yr \u003d\u003d 2013) \u0026 (mo \u003d\u003d 1):\n        header \u003d True\n    \n    df.to_csv(OUT_DATA_DIR + OUT_FILE, mode\u003d\u0027a\u0027, header\u003dheader, index\u003dFalse)\n\nconn.close()",
