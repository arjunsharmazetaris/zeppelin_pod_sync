    {
      "text": "\nimport json\nimport sqlite3\nimport traceback\nfrom difflib import SequenceMatcher\n\ndef load_spider_dataset(path):\n    with open(path) as f:\n        return json.load(f)\n\ndef load_spider_test_dataset(path):\n    with open(path) as f:\n        return json.load(f)\n\ndef get_actual_schema(db_path):\n    cursor \u003d conn.cursor()\n    sql_query\u003d\u0027select * from catalog.all_src where data_mart_name \u003d\"PATIENTDM\"\u0027\n    curs.execute(sql_query)\n    tables \u003d [row[0] for row in curs.fetchall()]\n    \n    schema \u003d {\u0027table_names\u0027: tables, \u0027column_names\u0027: [], \u0027column_types\u0027: []}\n    for table in tables:\n        cursor.execute(sql_query)\n        for col in cursor.fetchall():\n            schema[\u0027column_names\u0027].append([tables.index(table), col[1]])\n            schema[\u0027column_types\u0027].append(col[2])\n    \n    conn.close()\n    return schema\n\ndef query_similarity(query1, query2):\n    return SequenceMatcher(None, query1.lower(), query2.lower()).ratio()\n\ndef llm_generate(prompt):\n    # Placeholder for LLM inference – replace with your own model call\n    print(\"Prompt sent to LLM:\")\n    print(prompt)\n    return \"SELECT * FROM department;\"  # Replace this with actual model inference\n\ndef divide_and_conquer(question, schema):\n    schema_info \u003d \"Database Schema:\\n\"\n    for table_id, table in enumerate(schema[\u0027table_names\u0027]):\n        schema_info +\u003d f\"Table: {table}\\n\"\n        columns \u003d [column[1] for column in schema[\u0027column_names\u0027] if column[0] \u003d\u003d table_id]\n        for col in columns:\n            col_index \u003d columns.index(col)\n            col_type \u003d schema[\u0027column_types\u0027][col_index]\n            schema_info +\u003d f\"    - {col} ({col_type})\\n\"\n        schema_info +\u003d \"\\n\"\n\n    prompt \u003d f\"\"\"\n{schema_info}\n\nGiven the above database schema, generate a SQL query pertaining to the provided schema to answer the following question:\n{question}\n\nIMPORTANT: \n1. DO NOT MAKE UP COLUMN NAMES. USE ONLY THE PROVIDED TABLE NAMES AND ASSOCIATED COLUMNS.\n2. Ensure the query is syntactically correct and complete for SQLite.\n3. Include joins where necessary based on the foreign key relationships.\n4. Use SQLite date functions for any date calculations (e.g., strftime, date, julianday).\n5. Generate the query only, don\u0027t add any additional text or formatting.\n6. Don\u0027t use strftime to modify date fields in the query, select dates as is.\n\"\"\"\n\n    sql_query \u003d llm_generate(prompt)\n    return sql_query.replace(\"```sql\", \"\").replace(\"```\", \"\")\n\ndef run_evaluation(max_qs):\n    results \u003d []\n\n    try:\n        conn \u003d jaydebeapi.connect(driver_class, connection_string, [uid, pwd], temp_file_path)\n        cursor \u003d conn.cursor()\n\n\n        for i, (q, a_query) in enumerate(zip(questions, actual_queries)):\n            if i \u003e\u003d max_qs:\n                break\n            print(f\"\\nQuestion {i+1}: {q}\")\n            print(f\"Actual SQL: {a_query}\")\n\n            g_query \u003d divide_and_conquer(q, schema)\n            print(f\"Generated SQL: {g_query}\")\n\n            sim \u003d query_similarity(g_query, a_query)\n            print(f\"Query similarity: {sim:.2%}\")\n\n            try:\n                cursor.execute(g_query)\n                gen_result \u003d cursor.fetchall()\n\n                cursor.execute(a_query)\n                act_result \u003d cursor.fetchall()\n\n                results_match \u003d gen_result \u003d\u003d act_result\n\n                print(f\"Results match: {results_match}\")\n                results.append({\n                    \u0027question\u0027: q,\n                    \u0027generated_query\u0027: g_query,\n                    \u0027actual_query\u0027: a_query,\n                    \u0027results_match\u0027: results_match,\n                    \u0027query_similarity\u0027: sim\n                })\n\n            except sqlite3.Error as e:\n                print(f\"SQL execution error: {e}\")\n                results.append({\n                    \u0027question\u0027: q,\n                    \u0027generated_query\u0027: g_query,\n                    \u0027actual_query\u0027: a_query,\n                    \u0027results_match\u0027: False,\n                    \u0027query_similarity\u0027: sim,\n                    \u0027error\u0027: str(e)\n                })\n\n        total \u003d len(results)\n        correct \u003d sum(1 for r in results if r[\u0027results_match\u0027])\n        avg_sim \u003d sum(r[\u0027query_similarity\u0027] for r in results) / total if total else 0\n\n        print(\"\\nFinal Summary:\")\n        print(f\"Total Queries: {total}\")\n        print(f\"Correct: {correct}\")\n        print(f\"Accuracy: {correct/total:.2%}\")\n        print(f\"Avg Similarity: {avg_sim:.2%}\")\n\n    except Exception as e:\n        print(f\"Fatal Error: {e}\")\n        traceback.print_exc()\n\n    return results\n\n\n\n",
