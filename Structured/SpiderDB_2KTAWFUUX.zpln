ATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027), (\u0027PATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027), (\u0027PATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027), (\u0027PATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027), (\u0027PATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027), (\u0027PATIENTDM\u0027, \u0027ENCOUNTERS\u0027, \u0027`HOSPITAL`.`ENCOUNTERS`\u0027, \u0027patient\u0027, \u0027patient\u0027, \u0027string\u0027)]"
