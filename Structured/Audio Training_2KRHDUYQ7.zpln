    {
      "text": "%python\n\n# 1. Install Dependencies (Run this in your shell or bootstrap)\n!pip install openai-whisper datasets transformers sentencepiece torchaudio\n\n# 2. Import Libraries\nimport whisper\nfrom transformers import AutoModelForCausalLM, AutoTokenizer, Trainer, TrainingArguments\nfrom datasets import Dataset\nimport os\n\n# 3. Transcription Function (Whisper)\nmodel \u003d whisper.load_model(\"base\")  # Or \"small\", \"medium\", \"large\"\n\ndef transcribe_audio(audio_path):\n    result \u003d model.transcribe(audio_path)\n    return result[\u0027text\u0027]\n\n# 4. Load and Transcribe Audio Files\naudio_dir \u003d \"/home/zetaris/zeppelin/audio_samples\"\ndata \u003d []\n\nfor filename in os.listdir(audio_dir):\n    if filename.endswith(\".wav\") or filename.endswith(\".mp3\"):\n        full_path \u003d os.path.join(audio_dir, filename)\n        transcript \u003d transcribe_audio(full_path)\n        data.append({\"text\": transcript})\n\n# 5. Prepare Dataset for Fine-tuning\ndataset \u003d Dataset.from_list(data)\ndataset \u003d dataset.train_test_split(test_size\u003d0.1)\n\n# 6. Load Base Model for Fine-Tuning (e.g., TinyDialoGPT)\nmodel_name \u003d \"microsoft/DialoGPT-small\"\ntokenizer \u003d AutoTokenizer.from_pretrained(model_name)\nmodel \u003d AutoModelForCausalLM.from_pretrained(model_name)\n# Add pad token if needed\nif tokenizer.pad_token is None:\n    tokenizer.pad_token \u003d tokenizer.eos_token\n    # OR to use a new token:\n    # tokenizer.add_special_tokens({\u0027pad_token\u0027: \u0027[PAD]\u0027})\n    # model.resize_token_embeddings(len(tokenizer))\n\n\n\n",
      "user": "RAINATHOMAS@GMAIL.COM",
      "dateUpdated": "2025-04-17 00:08:03.762",
      "progress": 0,
      "config": {
