[0] \u003d\u003d table_id]\n                                                                      ^\n\u003cconsole\u003e:47: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"column_types\")\n                   col_type \u003d schema[\u0027column_types\u0027][col_index]\n                                                  ^\n\u003cconsole\u003e:74: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"db_id\")\n               db_id \u003d spider_data[0][\u0027db_id\u0027]\n                                            ^\n\u003cconsole\u003e:79: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"db_id\")\n               dept_data \u003d [item for item in test_data if item[\u0027db_id\u0027] \u003d\u003d db_id]\n                                                                     ^\n\u003cconsole\u003e:80: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"question\")\n               questions \u003d [item[\u0027question\u0027] for item in dept_data]\n                                          ^\n\u003cconsole\u003e:81: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"query\")\n               actual_queries \u003d [item[\u0027query\u0027] for item in dept_data]\n                                            ^\n\u003cconsole\u003e:128: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"results_match\")\n               correct \u003d sum(1 for r in results if r[\u0027results_match\u0027])\n                                                                   ^\n\u003cconsole\u003e:129: \u001b[31merror: \u001b[0munclosed character literal (or use \" for string literal \"query_similarity\")\n               avg_sim \u003d sum(r[\u0027query_similarity\u0027] for r in results) / total if total else 0\n                                                ^\n\u003cconsole\u003e:145: \u001b[31merror: \u001b[0munclosed character literal (or use \" not \u0027 for string literal)\n           parser.add_argument(\u0027--spider_path\u0027, required\u003dTrue, help\u003d\"Path to Spider dev/train dataset JSON\")\n                                             ^\n\u003cconsole\u003e:146: \u001b[31merror: \u001b[0munclosed character literal (or use \" not \u0027 for string literal)\n           parser.add_argument(\u0027--db_root\u0027, required\u003dTrue, help\u003d\"Path to root directory of SQLite DBs\")\n                                         ^\n\u003cconsole\u003e:147: \u001b[31merror: \u001b[0munclosed character literal (or use \" not \u0027 for string literal)\n           parser.add_argument(\u0027--test_data\u0027, required\u003dTrue, help\u003d\"Path to Spider test examples JSON\")\n                                           ^\n\u003cconsole\u003e:148: \u001b[31merror: \u001b[0munclosed character literal (or use \" not \u0027 for string literal)\n           parser.add_argument(\u0027--max_qs\u0027, type\u003dint, default\u003d10, help\u003d\"Max number of questions to test\")\n                                        ^\n"
