    {
      "text": "import requests\r\nimport json\r\nimport uuid\r\nfrom base64 import b64encode\r\n\r\nclass ZetarisClient:\r\n    def __init__(self, api_url: str, org_id: str \u003d \"1568338\"):\r\n        self.api_url \u003d api_url\r\n        self.org_id \u003d org_id\r\n        self.bearer_token \u003d None\r\n        self.refresh_token \u003d None\r\n\r\n    def _get_auth(self, token\u003dNone):\r\n        if token is None:\r\n            token \u003d self.bearer_token\r\n        return {\r\n            \"Authorization\": token,\r\n            \"X-Request-ID\": str(uuid.uuid1()),\r\n            \"X-Org-ID\": self.org_id\r\n        }\r\n\r\n    def basic_auth(self, username: str, password: str):\r\n        token \u003d b64encode(f\"{username}:{password}\".encode(\u0027utf-8\u0027)).decode(\"ascii\")\r\n        return f\u0027Basic {token}\u0027\r\n\r\n    def login(self, username: str, password: str):\r\n        auth \u003d self._get_auth(self.basic_auth(username, password))\r\n        res \u003d requests.get(f\u0027{self.api_url}/api/v1.0/auth/login\u0027, headers\u003dauth)\r\n        data \u003d res.json()\r\n        self.bearer_token \u003d f\"Bearer {data[\u0027idToken\u0027]}\"\r\n        self.refresh_token \u003d f\"Bearer {data[\u0027refreshToken\u0027]}\"\r\n\r\n    def refresh_tokens(self):\r\n        auth \u003d self._get_auth(self.refresh_token)\r\n        res \u003d requests.get(f\u0027{self.api_url}/api/v1.0/auth/refresh\u0027, headers\u003dauth)\r\n        data \u003d res.json()\r\n        self.bearer_token \u003d f\"Bearer {data[\u0027idToken\u0027]}\"\r\n        self.refresh_token \u003d f\"Bearer {data[\u0027refreshToken\u0027]}\"\r\n\r\n    # ---------------- Pipeline Methods ----------------\r\n    def get_pipeline_containers(self):\r\n        return requests.get(f\u0027{self.api_url}/api/v1.0/pipeline/containers\u0027, headers\u003dself._get_auth()).json()\r\n\r\n    def get_pipeline_relations(self, pipeline_container_id: int):\r\n        return requests.get(f\u0027{self.api_url}/api/v1.0/pipeline/containers/{pipeline_container_id}/relations\u0027, headers\u003dself._get_auth()).json()\r\n\r\n    def execute_pipeline(self, pipeline_container_id: int, pipeline_relation_id: int, page_limit: int):\r\n        body \u003d json.dumps({\"pageLimit\": page_limit})\r\n        res \u003d requests.post(f\u0027{self.api_url}/api/v1.0/pipeline/containers/{pipeline_container_id}/relations/{pipeline_relation_id}/execute\u0027, headers\u003dself._get_auth(), data\u003dbody)\r\n        return res.json()\r\n\r\n    # ---------------- SQL Query Methods ----------------\r\n    def open_sql_query(self, sql_query: str, page_limit: int \u003d 100):\r\n        body \u003d json.dumps({\"select\": sql_query, \"pageLimit\": page_limit})\r\n        return requests.post(f\u0027{self.api_url}/api/v1.0/query/sql/start\u0027, headers\u003dself._get_auth(), data\u003dbody).json()\r\n\r\n    def page_sql_query(self, query_token: str, page_limit: int, page_number: int):\r\n        params \u003d {\"queryToken\": query_token, \"pageLimit\": page_limit, \"pageNumber\": page_number}\r\n        return requests.get(f\u0027{self.api_url}/api/v1.0/query/sql/page\u0027, headers\u003dself._get_auth(), params\u003dparams).json()\r\n\r\n    def close_sql_query(self, query_token: str):\r\n        requests.delete(f\u0027{self.api_url}/api/v1.0/query/sql/close/{query_token}\u0027, headers\u003dself._get_auth())\r\n\r\n    def run_sql(self, sql: str):\r\n        return requests.post(f\u0027{self.api_url}/api/v1.0/sql-editor/sqls/run\u0027, headers\u003dself._get_auth(), json\u003d{\"sql\": sql}).json()\r\n\r\n    def generic_query(self, sql_query: str):\r\n        return requests.post(f\u0027{self.api_url}/api/v1.0/query/sql/generic-query\u0027, headers\u003dself._get_auth(), json\u003d{\"sql\": sql_query}).json()\r\n\r\n    def register_table(self, datasource_name: str, table_name: str):\r\n        body \u003d json.dumps({\"dataSourceName\": datasource_name, \"tableName\": table_name})\r\n        return requests.post(f\u0027{self.api_url}/api/v1.0/query/sql/register-table\u0027, headers\u003dself._get_auth(), data\u003dbody).json()\r\n\r\n    def select_query(self, select_query: str, page_limit: int \u003d 100):\r\n        result \u003d self.open_sql_query(select_query, page_limit)\r\n        data \u003d result[\u0027records\u0027]\r\n        query_token \u003d result[\u0027queryToken\u0027]\r\n        max_pages \u003d result[\u0027totalPages\u0027]\r\n\r\n        for i in range(2, max_pages + 1):\r\n            page_data \u003d self.page_sql_query(query_token, page_limit, i)\r\n            data +\u003d page_data[\u0027records\u0027]\r\n\r\n        self.close_sql_query(query_token)\r\n        return data\r\n\r\n    # ---------------- CBAC Methods ----------------\r\n    def get_table_cbac(self, table_type: str, database_name: str, table_name: str):\r\n        return requests.get(f\u0027{self.api_url}/api/v1.0/access-control/cbac/generic/{table_type}/{database_name}/{table_name}\u0027, headers\u003dself._get_auth()).json()\r\n\r\n    def update_table_cbac(self, table_type: str, database_name: str, table_name: str, policy_name: str, filter_name: str, user_list: list, role_list: list):\r\n        body \u003d {\r\n            \"version\": 0,\r\n            \"id\": f\"{database_name}.{table_name}\",\r\n            \"partitionColumns\": [],\r\n            \"users\": user_list,\r\n            \"policies\": [{\"policyName\": policy_name, \"filter\": filter_name, \"fields\": []}],\r\n            \"roles\": role_list\r\n        }\r\n        return requests.post(f\u0027{self.api_url}/api/v1.0/access-control/cbac/generic/{table_type}/{database_name}/{table_name}\u0027, headers\u003dself._get_auth(), json\u003dbody)\r\n\r\n    def clear_query_cache(self, username: str):\r\n        requests.delete(f\u0027{self.api_url}/api/v1.0/query/sql/clear/{username}\u0027, headers\u003dself._get_auth())\r\n\r\n\r\n# ---------------- Runner Function for Select Queries ----------------\r\ndef process_selected_dm_tables(apiurl, username, password):\r\n    client \u003d ZetarisClient(apiurl)\r\n    client.login(username, password)\r\n\r\n    dmfull \u003d \"my_test_db\"\r\n    dmtables \u003d [\u0027orders_order\u0027, \u0027product_catalog\u0027]\r\n\r\n    for table in dmtables:\r\n        query \u003d f\"SELECT * FROM {dmfull}.{table} LIMIT 10\"\r\n        print(f\"Running Query: {query}\")\r\n        result \u003d client.select_query(query)\r\n        print({\"data\": result})\r\n\r\n    return \u0027Process completed successfully\u0027\r\n\r\n\r\n# Run the function\r\nprocess_selected_dm_tables(\r\n    \u0027https://api.saas.enterprise.zetaris.com/\u0027,\r\n    \u0027tirthankar.debnath@zetaris.com\u0027,\r\n    \u0027P@55word\u0027\r\n)\r\n",
      "user": "TIRTHANKAR.DEBNATH@ZETARIS.COM",
