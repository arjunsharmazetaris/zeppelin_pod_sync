    },
    {
      "text": "#Function to get data from Zetaris by passing the select query.\r\n\r\ndef SelectQuery(select_query):\r\n    page_limit \u003d 100\r\n    x \u003d open_sql_query(select_query,page_limit)\r\n    data \u003d x[\u0027records\u0027]\r\n    query_token \u003d x[\u0027queryToken\u0027]\r\n    max_pages \u003d x[\u0027totalPages\u0027]\r\n    for i in range(2,max_pages+1):\r\n        page_data\u003dpage_sql_query(query_token,page_limit,i)\r\n        data +\u003d page_data[\u0027records\u0027]\r\n    return data\r\n\r\n\r\n#Get the relevent data mart tables and store the relevant data as csv or json\r\n\r\ndef process_selected_dm_tables(apiurl, username, password):\r\n    \r\n    dmfull\u003d\"tirtho_new\"\r\n    dmtables\u003d[\u0027tirtho_pipeline\u0027]\r\n    try:\r\n        set_api_base_url(apiurl)\r\n        login(username, password)\r\n        for table in dmtables:\r\n            select_query_initial \u003d f\"SELECT * FROM {dmfull}.{table} limit 10\"\r\n            csv_filename \u003d f\"{dmfull}_{table}.csv\"\r\n            print(\u0027Printing Select Query\u0027)\r\n            print(select_query_initial)  \r\n            data_zetaris \u003d SelectQuery(select_query_initial)\r\n            updated_data \u003d {\u0027data\u0027: data_zetaris}\r\n            print(updated_data)\r\n        return \u0027Process completed successfully\u0027\r\n\r\n    except Exception as e:\r\n        return f\"An error occurred: {str(e)}\"\r\n\r\nprocess_selected_dm_tables(\u0027https://api.saas.enterprise.zetaris.com/\u0027,\u0027tirthankar.debnath@zetaris.com\u0027,\u0027P@55word\u0027)\r\n\r\nimport pandas as pd\r\n\r\ndef process_selected_dm_tables(apiurl, username, password):\r\n    dmfull \u003d \"tirtho_new\"\r\n    dmtables \u003d [\u0027tirtho_pipeline\u0027]\r\n\r\n    try:\r\n        set_api_base_url(apiurl)\r\n        login(username, password)\r\n        \r\n        for table in dmtables:\r\n            select_query_initial \u003d f\"SELECT * FROM {dmfull}.{table} LIMIT 10\"\r\n            print(\u0027Printing Select Query:\u0027)\r\n            print(select_query_initial)\r\n\r\n            data_zetaris \u003d SelectQuery(select_query_initial)\r\n\r\n            # If data_zetaris is a list of dicts or rows, convert to DataFrame\r\n            df \u003d pd.DataFrame(data_zetaris)\r\n\r\n            # Show the DataFrame\r\n            print(\"\\nFetched Data:\")\r\n            print(df)\r\n\r\n            # Save as CSV\r\n            csv_filename \u003d f\"{dmfull}_{table}.csv\"\r\n            df.to_csv(csv_filename, index\u003dFalse)\r\n            print(f\"Data saved to {csv_filename}\")\r\n\r\n            # Save as JSON\r\n            json_filename \u003d f\"{dmfull}_{table}.json\"\r\n            df.to_json(json_filename, orient\u003d\"records\", indent\u003d4)\r\n            print(f\"Data saved to {json_filename}\")\r\n        \r\n        return \u0027Process completed successfully\u0027\r\n\r\n    except Exception as e:\r\n        return f\"An error occurred: {str(e)}\"\r\n\r\n# Run the function\r\nprocess_selected_dm_tables(\r\n    \u0027https://api.saas.enterprise.zetaris.com/\u0027,\r\n    \u0027tirthankar.debnath@zetaris.com\u0027,\r\n    \u0027P@55word\u0027\r\n)",
