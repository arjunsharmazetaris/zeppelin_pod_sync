{
  "paragraphs": [
    {
      "text": "import requests\r\nimport json\r\nimport uuid\r\nimport os\r\nfrom base64 import b64encode\r\nimport base64\r\nimport pandas as pd\r\nimport matplotlib.pyplot as plt\r\n\r\nclass ZetarisAPI:\r\n    def __init__(self, url: str, username: str, password: str):\r\n        self.api_url \u003d url\r\n        self.username \u003d username\r\n        self.password \u003d password\r\n        self.bearer_token \u003d None\r\n        self.refresh_token \u003d None\r\n\r\n    def get_auth(self, token\u003dNone):\r\n        if token is None:\r\n            token \u003d self.bearer_token\r\n        return {\r\n            \"Authorization\": token,\r\n            \"X-Request-ID\": str(uuid.uuid1()),\r\n            \"X-Org-ID\": \"1568338\"\r\n        }\r\n\r\n    def basic_auth(self, username: str, password: str):\r\n        token \u003d b64encode(f\"{username}:{password}\".encode(\u0027utf-8\u0027)).decode(\"ascii\")\r\n        return f\u0027Basic {token}\u0027\r\n\r\n    def login(self):\r\n        auth \u003d self.get_auth(self.basic_auth(self.username, self.password))\r\n        response \u003d requests.get(url\u003df\u0027{self.api_url}/api/v1.0/auth/login\u0027, headers\u003dauth)\r\n        response \u003d json.loads(response.text)\r\n        self.bearer_token \u003d f\"Bearer {response[\u0027idToken\u0027] }\"\r\n        self.refresh_token \u003d f\"Bearer {response[\u0027refreshToken\u0027]}\"\r\n\r\n    def open_sql_query(self, sql_query: str, page_limit: int \u003d 100):\r\n        auth \u003d self.get_auth()\r\n        body \u003d json.dumps({\"select\": sql_query, \"pageLimit\": page_limit})\r\n        response \u003d requests.post(url\u003df\u0027{self.api_url}/api/v1.0/query/sql/start\u0027, headers\u003dauth, data\u003dbody)\r\n        response \u003d json.loads(response.text)\r\n        return response\r\n\r\n    def page_sql_query(self, query_token: str, page_limit: int, page_number: int):\r\n        auth \u003d self.get_auth()\r\n        params \u003d {\"queryToken\": query_token, \"pageLimit\": page_limit, \"pageNumber\": page_number}\r\n        response \u003d requests.get(url\u003df\u0027{self.api_url}/api/v1.0/query/sql/page\u0027, headers\u003dauth, params\u003dparams)\r\n        return json.loads(response.text)\r\n\r\n    def close_sql_query(self, query_token: str):\r\n        auth \u003d self.get_auth()\r\n        requests.delete(url\u003df\u0027{self.api_url}/api/v1.0/query/sql/close/{query_token}\u0027, headers\u003dauth)\r\n\r\n    def select_query(self, sql_query: str):\r\n        page_limit \u003d 100\r\n        initial \u003d self.open_sql_query(sql_query, page_limit)\r\n        data \u003d initial[\u0027records\u0027]\r\n        query_token \u003d initial[\u0027queryToken\u0027]\r\n        total_pages \u003d initial[\u0027totalPages\u0027]\r\n\r\n        for page in range(2, total_pages + 1):\r\n            page_data \u003d self.page_sql_query(query_token, page_limit, page)\r\n            data +\u003d page_data[\u0027records\u0027]\r\n\r\n        self.close_sql_query(query_token)\r\n        return data\r\n\r\n\r\ndef process_selected_dm_tables(api_url, username, password):\r\n    api \u003d ZetarisAPI(api_url, username, password)\r\n    api.login()\r\n\r\n    dm_name \u003d \"my_test_db\"\r\n    orders_table \u003d \u0027orders_order\u0027\r\n    product_table \u003d \u0027product_catalog\u0027\r\n\r\n    try:\r\n        query_orders \u003d f\"SELECT * FROM {dm_name}.{orders_table}\"\r\n        query_products \u003d f\"SELECT * FROM {dm_name}.{product_table}\"\r\n\r\n        orders_data \u003d api.select_query(query_orders)\r\n        products_data \u003d api.select_query(query_products)\r\n\r\n        df_orders \u003d pd.DataFrame(orders_data)\r\n        df_products \u003d pd.DataFrame(products_data)\r\n\r\n        df_merged \u003d pd.merge(df_orders, df_products, on\u003d\u0027sku\u0027, how\u003d\u0027inner\u0027)\r\n\r\n        sku_counts \u003d df_merged[\u0027sku\u0027].value_counts().nlargest(10)\r\n\r\n        plt.figure(figsize\u003d(10, 6))\r\n        sku_counts.plot(kind\u003d\u0027bar\u0027, color\u003d\u0027skyblue\u0027)\r\n        plt.title(\u0027Top 10 SKUs by Order Count\u0027)\r\n        plt.xlabel(\u0027SKU\u0027)\r\n        plt.ylabel(\u0027Order Count\u0027)\r\n        plt.xticks(rotation\u003d45)\r\n        plt.tight_layout()\r\n        plt.show()\r\n\r\n        return \u0027Process completed successfully\u0027\r\n\r\n    except Exception as e:\r\n        return f\"An error occurred: {str(e)}\"\r\n\r\n\r\n# Run the function\r\nprocess_selected_dm_tables(\u0027https://api.saas.enterprise.zetaris.com/\u0027, \u0027arjun.sharma@zetaris.com\u0027, \u0027P@55word\u0027)\r\n",
      "user": "ARJUN.SHARMA@ZETARIS.COM",
