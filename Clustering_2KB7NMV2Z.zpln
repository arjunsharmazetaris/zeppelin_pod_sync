    {
      "text": "# Assuming df and n_clusters are already defined\nrev_per_cluster \u003d 5\nall_reviews \u003d []\n\nfor i in range(n_clusters):\n    reviews \u003d \"\\n\".join(\n        df[df.Cluster \u003d\u003d i]\n        .combined.str.replace(\"Title: \", \"\")\n        .str.replace(\"\\n\\nContent: \", \":  \")\n        .sample(rev_per_cluster, random_state\u003d42)\n        .values\n    )\n    all_reviews.append({\"Cluster\": i, \"Reviews\": reviews})\n\n# Create a DataFrame\nreviews_df \u003d pd.DataFrame(all_reviews)\n\n# Convert the DataFrame to CSV in memory\ncsv_buffer \u003d BytesIO()\nreviews_df.to_csv(csv_buffer, index\u003dFalse)\ncsv_buffer.seek(0)\n\nconnection_string \u003d \"DefaultEndpointsProtocol\u003dhttps;AccountName\u003dzetarisqaztsta;AccountKey\u003dWLAB0sRhp/3rQpodbdMDV/aFfwPBIBKXZGBHWQ6o4PhxQvmpb+c7D9Nv4ydISm2A4eEmj0zda4Fh+AStfKaoeQWLAB0sRhp/3rQpodbdMDV/aFfwPBIBKXZGBHWQ6o4PhxQvmpb+c7D9Nv4ydISm2A4eEmj0zda4Fh+AStfKaoeQWLAB0sRhp/3rQpodbdMDV/aFfwPBIBKXZGBHWQ6o4PhxQvmpb+c7D9Nv4ydISm2A4eEmj0zda4Fh+AStfKaoeQ\u003d\u003d;EndpointSuffix\u003dcore.windows.net\"\nshare_name \u003d \"cusdatashare\"\nfolder_path \u003d \"1d0c220d/file-store/FineFoodTest\"\nfile_name \u003d \"reviews.csv\"\n\n# Create a ShareServiceClient\nservice_client \u003d ShareServiceClient.from_connection_string(connection_string)\n\n# Get a ShareClient for the file share\nshare_client \u003d service_client.get_share_client(share_name)\n\n# Get a ShareFileClient for the specific file\nfile_client \u003d share_client.get_file_client(f\"{folder_path}/{file_name}\")\n\n# Upload the CSV buffer to the file share\ncsv_buffer.seek(0)  # Reset the buffer position to the beginning\nfile_client.upload_file(csv_buffer.read())\n\n",
      "user": "RAINATHOMAS@GMAIL.COM",
