      "text": "#Generating Embeddings\n\nclient \u003d OpenAI(api_key\u003d\"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\")\n\ndef get_embedding(text, model\u003d\"text-embedding-ada-002\"):\n   text \u003d text.replace(\"\\n\", \" \")\n   return client.embeddings.create(input \u003d [text], \nmodel\u003dmodel).data[0].embedding\n\ndf[\u0027embedding\u0027] \u003d df.combined.apply(lambda x: get_embedding(x, model\u003d\u0027text-embedding-ada-002\u0027))",
