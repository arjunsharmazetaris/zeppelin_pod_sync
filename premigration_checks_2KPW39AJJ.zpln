      "text": "%spark.ipyspark\n\ndef excel_to_multiple_csv(excel_file, output_folder):\n    \n    connection_string \u003d \"DefaultEndpointsProtocol\u003dhttps;AccountName\u003dztdevsaasstacc;AccountKey\u003dASVqA3JusHezx4h/ltZG99Kn6DTjM8JwdnvreeViBBkZNE0sic7PP0IJ/1zqLvk/HGS+RQ1NKJxx+AStovQbug\u003d\u003d;EndpointSuffix\u003dcore.windows.net\"\n    share_name \u003d \"cusdatashare\"\n    folder_path \u003d \"7cd07542/file-store/Health\"\n    file_name \u003d \"hl7.csv\"\n    \n    # Load the Excel file\n    excel_data \u003d pd.ExcelFile(excel_file)\n    \n    # Loop through each sheet in the Excel file\n    for sheet_name in excel_data.sheet_names:\n        # Read each sheet into a DataFrame\n        df \u003d pd.read_excel(excel_file, sheet_name\u003dsheet_name)\n        \n        # Define the output CSV file name using the sheet name\n        csv_file \u003d f\"{output_folder}/{sheet_name}.csv\"\n        \n        # Save the DataFrame to CSV\n        df.to_csv(csv_file, index\u003dFalse)\n        print(f\"Sheet \u0027{sheet_name}\u0027 has been successfully converted to {csv_file}.\")\n\n\n",
