    {
      "text": "%spark.ipyspark\n\nfrom pyspark.sql import SparkSession\nimport os\n\ndef migrate_pdf_files(source_path, target_path):\n    \"\"\"\n    Migrate PDF files from source path to target path using Apache Spark\n    \n    Args:\n        source_path: Source directory or file path\n        target_path: Target directory path\n    \"\"\"\n    # Initialize Spark session\n    spark \u003d SparkSession.builder \\\n        .appName(\"PDF Migration\") \\\n        .getOrCreate()\n    \n    sc \u003d spark.sparkContext\n    \n    # Check if source is a directory or a single file\n    is_directory \u003d os.path.isdir(source_path)\n    \n    if is_directory:\n        # List all PDF files in the source directory\n        pdf_files \u003d [os.path.join(source_path, f) for f in os.listdir(source_path) \n                     if f.lower().endswith(\u0027.pdf\u0027)]\n    else:\n        # Single file case\n        if source_path.lower().endswith(\u0027.pdf\u0027):\n            pdf_files \u003d [source_path]\n        else:\n            raise ValueError(f\"Source file {source_path} is not a PDF file\")\n    \n    # Create RDD from the list of PDF files\n    pdf_files_rdd \u003d sc.parallelize(pdf_files)\n    \n    # Define a function to copy files\n    def copy_file(file_path):\n        from py4j.java_gateway import java_import\n        gateway \u003d sc._gateway\n        java_import(gateway.jvm, \"java.nio.file.*\")\n        \n        file_name \u003d os.path.basename(file_path)\n        target_file_path \u003d os.path.join(target_path, file_name)\n        \n        # Use Java\u0027s NIO to copy the file\n        source \u003d gateway.jvm.Paths.get(file_path)\n        target \u003d gateway.jvm.Paths.get(target_file_path)\n        \n        # Create target directory if it doesn\u0027t exist\n        target_dir \u003d gateway.jvm.Paths.get(target_path)\n        if not gateway.jvm.Files.exists(target_dir):\n            gateway.jvm.Files.createDirectories(target_dir)\n        \n        # Copy the file, replacing if exists\n        gateway.jvm.Files.copy(source, target, \n                              gateway.jvm.StandardCopyOption.REPLACE_EXISTING)\n        \n        return (file_path, target_file_path)\n    \n    # Process files in parallel\n    results \u003d pdf_files_rdd.map(copy_file).collect()\n    \n    # Print migration results\n    print(\"PDF Migration Results:\")\n    for source, target in results:\n        print(f\"Migrated: {source} -\u003e {target}\")\n    \n    print(f\"Successfully migrated {len(results)} PDF file(s)\")\n    \n    # Stop the Spark session\n    spark.stop()\n\n# Example usage\nif __name__ \u003d\u003d \"__main__\":\n    import argparse\n    \n    parser \u003d argparse.ArgumentParser(description\u003d\u0027Migrate PDF files using Apache Spark\u0027)\n    parser.add_argument(\u0027--source\u0027, required\u003dTrue, help\u003d\u0027Source directory or file path\u0027)\n    parser.add_argument(\u0027--target\u0027, required\u003dTrue, help\u003d\u0027Target directory path\u0027)\n    \n    args \u003d parser.parse_args()\n    \n    migrate_pdf_files(args.source, args.target)",
