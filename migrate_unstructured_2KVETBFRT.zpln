            "data": "\u001b[0;31m---------------------------------------------------------------------------\u001b[0m\n\u001b[0;31mAttributeError\u001b[0m                            Traceback (most recent call last)\nCell \u001b[0;32mIn[90], line 1\u001b[0m\n\u001b[0;32m----\u003e 1\u001b[0m sc\u001b[38;5;241m.\u001b[39msetJobGroup(\u001b[38;5;124m\u0027\u001b[39m\u001b[38;5;124mzeppelin|BEN.TZANNES@ZETARIS.COM|2KVETBFRT|paragraph_1746684397415_1500287209\u001b[39m\u001b[38;5;124m\u0027\u001b[39m, \u001b[38;5;124m\u0027\u001b[39m\u001b[38;5;124mStarted by: BEN.TZANNES@ZETARIS.COM\u001b[39m\u001b[38;5;124m\u0027\u001b[39m)\n\nFile \u001b[0;32m/opt/spark/python/lib/pyspark.zip/pyspark/context.py:2166\u001b[0m, in \u001b[0;36mSparkContext.setJobGroup\u001b[0;34m(self, groupId, description, interruptOnCancel)\u001b[0m\n\u001b[1;32m   2098\u001b[0m \u001b[38;5;28;01mdef\u001b[39;00m \u001b[38;5;21msetJobGroup\u001b[39m(\u001b[38;5;28mself\u001b[39m, groupId: \u001b[38;5;28mstr\u001b[39m, description: \u001b[38;5;28mstr\u001b[39m, interruptOnCancel: \u001b[38;5;28mbool\u001b[39m \u001b[38;5;241m\u003d\u001b[39m \u001b[38;5;28;01mFalse\u001b[39;00m) \u001b[38;5;241m-\u001b[39m\u001b[38;5;241m\u003e\u001b[39m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[1;32m   2099\u001b[0m \u001b[38;5;250m    \u001b[39m\u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m   2100\u001b[0m \u001b[38;5;124;03m    Assigns a group ID to all the jobs started by this thread until the group ID is set to a\u001b[39;00m\n\u001b[1;32m   2101\u001b[0m \u001b[38;5;124;03m    different value or cleared.\u001b[39;00m\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m   2164\u001b[0m \u001b[38;5;124;03m    Cancelled\u001b[39;00m\n\u001b[1;32m   2165\u001b[0m \u001b[38;5;124;03m    \"\"\"\u001b[39;00m\n\u001b[0;32m-\u003e 2166\u001b[0m     \u001b[38;5;28mself\u001b[39m\u001b[38;5;241m.\u001b[39m_jsc\u001b[38;5;241m.\u001b[39msetJobGroup(groupId, description, interruptOnCancel)\n\n\u001b[0;31mAttributeError\u001b