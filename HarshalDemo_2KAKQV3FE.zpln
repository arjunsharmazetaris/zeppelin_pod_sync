      "text": "import requests\nimport json\nimport uuid\nimport os\nfrom base64 import b64encode\nimport base64\n\ndef get_auth():\n  return {\n    \"Authorization\": \"Bearer akd0d8mo5ivbdapvafucgqpb0qe9un5v9bgjvvnuiq4wgzzn7qhr6l3kdflm\",\n    \"X-Request-ID\": str(uuid.uuid1()),\n    \"X-Org-ID\" : \"50702\"\n  }\n\ndef run_sql(sql:str,api_url):\n    auth \u003d get_auth()\n    body \u003d json.dumps({\n        \"sql\": sql,\n        \"source\": \"Generic\",\n        \"queryId\": str(uuid.uuid1())\n    })\n    response \u003d requests.post(url\u003df\u0027{api_url}/api/v1.0/sql-editor/sqls/run\u0027,headers\u003dauth,data\u003dbody)\n    response \u003d json.loads(response.text)\n    return response",
