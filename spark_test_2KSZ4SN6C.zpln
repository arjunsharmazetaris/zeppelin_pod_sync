      "text": "from pyspark.sql import SparkSession\n%spark.ipyspark\n\n\n# Initialize Spark Session (if not already done)\nspark \u003d SparkSession.builder.appName(\"ExploreDatabases\").getOrCreate()\n\n# List all databases\nprint(\"Available Databases:\")\nfor db in spark.catalog.listDatabases():\n    print(f\"- {db.name}\")\n\n# Choose one database and list its tables\nselected_db \u003d \"default\"  # or any other known database\nprint(f\"\\nTables in {selected_db}:\")\nfor table in spark.catalog.listTables(selected_db):\n    print(f\"- {table.name}\")\n",
