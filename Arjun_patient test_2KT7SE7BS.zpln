      "text": "#Get the relevent data mart tables and store the relevant data as csv or json\n\ndef process_selected_dm_tables(apiurl, username, password):\n    \n    dmfull_\u003d\"PatientDM\"\n    dmtables_\u003d[\u0027Patients\u0027,\u0027Visits\u0027]\n\n    \n    dmfull\u003d\"my_test_db\"\n    dmtables\u003d[\u0027orders_order\u0027,\u0027product_catalog\u0027]\n\n    try:\n        set_api_base_url(apiurl)\n        login(username, password)\n        for table in dmtables:\n            select_query_initial \u003d f\"SELECT * FROM {dmfull}.{table} limit 10\"\n            csv_filename \u003d f\"{dmfull}_{table}.csv\"\n            print(\u0027Printing Select Query\u0027)\n            print(select_query_initial)  \n            data_zetaris \u003d SelectQuery(select_query_initial)\n            updated_data \u003d {\u0027data\u0027: data_zetaris}\n            print(updated_data)\n        return \u0027Process completed successfully\u0027\n\n    except Exception as e:\n        return f\"An error occurred: {str(e)}\"",
