      "text": "# API Calls for Authentication and Query\n!#Import required libraries\nimport requests\nimport json\nimport uuid\nimport os\nimport pandas as pd\nimport numpy as np\nimport seaborn as sns\nimport matplotlib.pyplot as plt\nfrom base64 import b64encode\n\ndef get_auth():\n  return {\n    \"Authorization\": \"Bearer akqws10ki4ism7aqby10xdqgumbfufqz1wxzvanuvr6kizcbvduef7xujgt0\",\n    \"X-Request-ID\": str(uuid.uuid1()),\n    \"X-Org-ID\" : \"7\"\n  }\n\ndef run_sql(sql:str,api_url):\n    auth \u003d get_auth()\n    body \u003d json.dumps({\n        \"sql\": sql,\n        \"source\": \"Generic\",\n        \"queryId\": str(uuid.uuid1())\n    })\n    try:\n        response \u003d requests.post(url\u003df\u0027{api_url}/api/v1.0/sql-editor/sqls/run\u0027,headers\u003dauth,data\u003dbody)\n        response \u003d json.loads(response.text)\n        return response\n    except requests.exceptions.RequestException as e:\n        print(f\"Error executing SQL query: {e}\")\n        return []",
