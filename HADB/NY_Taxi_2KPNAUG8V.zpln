    {
      "text": "if __name__ \u003d\u003d \"__main__\":\n    # Zetaris API details - please change this URL to refer to your DNS name\n    api_url \u003d \u0027https://api.zetaris-uat.enterprise.zetaris.com/\u0027\n    query \u003d \u0027SELECT VendorId, tpep_dropoff_datetime , passenger_count, trip_distance, RatecodeID, store_and_fwd_flag , PULocationID ,DOLocationID  , payment_type , fare_amount , extra, mta_tax , tip_amount, tolls_amount,total_amount  , year FROM HA_DB_nytaxi.YELLOW_TRIPDATA  limit 50000\u0027\n\n    # Retrieve API keys from Zetaris\n    data_zetaris \u003d run_sql(query, api_url)",
