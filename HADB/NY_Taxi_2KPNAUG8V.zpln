    {
      "text": "def process_api_keys_and_register_endpoints(data_zetaris):\n    \"\"\"\n    Processes API keys from the data and registers endpoints by creating Lightning REST tables.\n\n    Args:\n        data_zetaris (list): List of dictionaries containing trip_distance and dropoff date.\n    \"\"\"\n    for record in data_zetaris:\n        headers \u003d data_zetaris[\u0027headers\u0027]\n        rows \u003d data_zetaris[\u0027data\u0027]\n        records \u003d [{headers[i]: row[i] for i in range(len(headers))} for row in rows]\n        updated_data \u003d {\u0027data\u0027: records}\n        df \u003d pd.DataFrame(updated_data[\u0027data\u0027])\n        df \u003d df[[\"trip_distance\", \"tpep_dropoff_datetime\"]]\n        df \u003d df.dropna()\n\n        # Data Cleaning\n        df[\"trip_distance\"] \u003d df[\"trip_distance\"].astype(str).str.strip()\n        df[\"tpep_dropoff_datetime\"] \u003d df[\"tpep_dropoff_datetime\"].astype(str).str.strip()\n        df[\u0027tpep_dropoff_datetime\u0027] \u003d pd.to_datetime(df[\u0027tpep_dropoff_datetime\u0027])\n\n        # Extract hour and weekday\n        df[\u0027dropoff_hour\u0027] \u003d df[\u0027tpep_dropoff_datetime\u0027].dt.hour\n        df[\u0027dropoff_weekday\u0027] \u003d df[\u0027tpep_dropoff_datetime\u0027].dt.weekday\n\n        # HEATMAP: Taxi Dropoff Density by Hour and Weekday\n        heatmap_data \u003d df.pivot_table(index\u003d\u0027dropoff_weekday\u0027, columns\u003d\u0027dropoff_hour\u0027, values\u003d\u0027trip_distance\u0027, aggfunc\u003d\u0027count\u0027)\n\n        plt.figure(figsize\u003d(12, 6))\n        sns.heatmap(heatmap_data, cmap\u003d\"YlGnBu\", linewidths\u003d0.5, annot\u003dTrue)\n        plt.title(\"Taxi Dropoff Density by Hour and Weekday\")\n        plt.xlabel(\"Hour of Day\")\n        plt.ylabel(\"Day of Week\")\n        plt.tight_layout()\n        z.show(plt)  # Show the first plot\n\n        # BAR PLOT: Hourly Trip Counts\n        trip_counts \u003d df[\u0027dropoff_hour\u0027].value_counts().sort_index()\n        plt.figure(figsize\u003d(10, 5))\n        sns.barplot(x\u003dtrip_counts.index, y\u003dtrip_counts.values, palette\u003d\"viridis\")\n        plt.title(\"Number of Trips per Hour\")\n        plt.xlabel(\"Hour of Day\")\n        plt.ylabel(\"Trip Count\")\n        plt.tight_layout()\n        z.show(plt)  # Show the second plot\n\n        # HISTOGRAM: Trip Distance Distribution\n        plt.figure(figsize\u003d(10, 5))\n        sns.histplot(df[\u0027trip_distance\u0027].astype(float), bins\u003d30, kde\u003dTrue)\n        plt.title(\"Trip Distance Distribution\")\n        plt.xlabel(\"Trip Distance (miles)\")\n        plt.ylabel(\"Frequency\")\n        plt.tight_layout()\n        z.show(plt)  # Show the third plot\n",
