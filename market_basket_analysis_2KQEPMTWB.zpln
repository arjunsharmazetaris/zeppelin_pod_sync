[38;5;241m.\u001b[39mProductID, how\u001b[38;5;241m\u003d\u001b[39m\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124minner\u001b[39m\u001b[38;5;124m\"\u001b[39m\n\u001b[1;32m     18\u001b[0m )\n\u001b[1;32m     20\u001b[0m \u001b[38;5;66;03m# Create a list of products bought in each order\u001b[39;00m\n\u001b[1;32m     21\u001b[0m \u001b[38;5;66;03m# Group by SalesOrderID and collect all the product names as a list\u001b[39;00m\n\u001b[0;32m---\u003e 22\u001b[0m transactions_df \u001b[38;5;241m\u003d\u001b[39m transactions_df\u001b[38;5;241m.\u001b[39mgroupBy(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mSalesOrderID\u001b[39m\u001b[38;5;124m\"\u001b[39m)\u001b[38;5;241m.\u001b[39magg(collect_list(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mProductName\u001b[39m\u001b[38;5;124m\"\u001b[39m)\u001b[38;5;241m.\u001b[39malias(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mitems\u001b[39m\u001b[38;5;124m\"\u001b[39m))\n\u001b[1;32m     24\u001b[0m \u001b[38;5;66;03m# DataFrame with a column of items bought in each transaction\u001b[39;00m\n\u001b[1;32m     25\u001b[0m transactions_df\u001b[38;5;241m.\u001b[39mshow(\u001b[38;5;241m5\u001b[39m)\n\n\u001b[0;31mNameError\u001b[0m: name \u0027collect_list\u0027 is not defined"
