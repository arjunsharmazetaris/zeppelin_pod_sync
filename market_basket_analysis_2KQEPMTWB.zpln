    {
      "text": "%spark.ipyspark\n\nsales_order_detail_df \u003d spark.sql(\"SELECT * FROM LIGHTNING_DB.SalesOrderDetail LIMIT 200\")\nproduct_df \u003d spark.sql(\"SELECT * FROM LEGACY_DB.Product LIMIT 200\")\n\n# Show the structure of the SalesOrderDetail dataset\nsales_order_detail_df.show(5)\n\n# Clean and preprocess the data:\n# We need to create transactions for market basket analysis, \n# which means each row should represent a single transaction with a list of product IDs.\n\n# Join SalesOrderDetail with Product to get product names (optional)\ntransactions_df \u003d sales_order_detail_df.join(\n    product_df, sales_order_detail_df.ProductID \u003d\u003d product_df.ProductID, how\u003d\"inner\"\n)\n\n# Create a list of products bought in each order\n# Group by SalesOrderID and collect all the product names as a list\ntransactions_df \u003d transactions_df.groupBy(\"SalesOrderID\").agg(collect_list(\"ProductName\").alias(\"items\"))\n\n# DataFrame with a column of items bought in each transaction\ntransactions_df.show(5)\n\n# Apply FPGrowth to find frequent itemsets\nfp_growth \u003d FPGrowth(itemsCol\u003d\"items\", minSupport\u003d0.01, minConfidence\u003d0.5)\nmodel \u003d fp_growth.fit(transactions_df)\n\n# Get frequent itemsets\nfrequent_itemsets \u003d model.freqItemsets\nfrequent_itemsets.show(5)\n\n# Get association rules\nassociation_rules \u003d model.associationRules\nassociation_rules.show(5)\n\nhigh_confidence_rules \u003d association_rules.filter(col(\"confidence\") \u003e 0.7)\nhigh_confidence_rules.show(5)\n",
      "user": "JIM@LIGHTNING.COM",
      "dateUpdated": "2025-03-26 13:09:12.914",
      "progress": 0,
      "config": {
