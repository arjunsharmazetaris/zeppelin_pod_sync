    {
      "text": "# Azure Blob Storage configuration\nblob_connection_string \u003d \"DefaultEndpointsProtocol\u003dhttps;AccountName\u003dzetarisdriversjars;AccountKey\u003dCCUTlDRpA7sxsieGGIe4pjWmQC/DDiKczoUbINRVyuXqCnnrBPAYX6FM3F3lISK+RQwUKKWgo8jU+AStNm/QOw\u003d\u003d;EndpointSuffix\u003dcore.windows.net\"\ncontainer_name \u003d \"jdbcdriver\"  # Replace with your container name\nblob_name \u003d \"zetaris-ndp-jdbc-2.1.0.11.jar\"  # Replace with the path to the JAR file in the blob\n\n# Initialize Azure Blob Service Client\nblob_service_client \u003d BlobServiceClient.from_connection_string(blob_connection_string)\ncontainer_client \u003d blob_service_client.get_container_client(container_name)\nblob_client \u003d container_client.get_blob_client(blob_name)\n\n# Create a temporary file to store the downloaded JAR\nwith tempfile.NamedTemporaryFile(delete\u003dFalse, suffix\u003d\".jar\") as temp_file:\n    temp_file_path \u003d temp_file.name\n    # Download the JAR file from Azure Blob Storage\n    with open(temp_file_path, \"wb\") as f:\n        blob_data \u003d blob_client.download_blob()\n        f.write(blob_data.readall())\n\nhost \u003d \"4.147.140.215\"\nport \u003d \"10000\"\nuid \u003d \"rainathomas@gmail.com\"\npwd \u003d \"P@55word\"\n\n# pwd \u003d str(getpass.getpass())\nconnection_string \u003d f\u0027jdbc:zetaris:lightning@{host}:{port}\u0027\ndriver_class \u003d \"com.zetaris.lightning.jdbc.LightningDriver\"\n\n# Establish the connection using the temporary JAR file path\ntry:\n    con \u003d jaydebeapi.connect(driver_class, connection_string, [uid, pwd], temp_file_path)\n    curs \u003d con.cursor()\n    print(\"Connection established successfully!\")\nexcept Exception as e:\n    print(f\"Error establishing connection: {e}\")\nfinally:\n    # Clean up: Delete the temporary JAR file\n    if os.path.exists(temp_file_path):\n        os.remove(temp_file_path)",
