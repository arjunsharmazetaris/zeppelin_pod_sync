    {
      "text": "import subprocess\r\n\r\n# Define the notebook directory and backup file path\r\nnotebook_dir \u003d \"/home/zetaris/zeppelin/notebooks\"\r\nbackup_file \u003d \"/tmp/zeppelin_backup.tar.gz\"\r\n\r\n# Create a tar.gz archive of the notebooks directory\r\ntry:\r\n    subprocess.run(f\"tar -czf {backup_file} {notebook_dir}\", shell\u003dTrue, check\u003dTrue)\r\n    print(f\"✅ Backup created at {backup_file}\")\r\nexcept subprocess.CalledProcessError as e:\r\n    print(f\"❌ Error creating backup: {e}\")\r\n",
      "user": "ARJUN.SHARMA@ZETARIS.COM",
      "dateUpdated": "2025-05-20 11:27:58.787",
