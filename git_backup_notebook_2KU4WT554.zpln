      "text": "%python\nfrom git import Repo, GitCommandError\nimport os\n\nnotebook_dir \u003d \"/home/zetaris/zeppelin/notebooks\"\nrepo_path \u003d \"/tmp/zeppelin_sync_repo\"\nGIT_TOKEN \u003d \"###########\"\nremote_url \u003d f\"https://arjunsharmazetaris:{GIT_TOKEN}@github.com/arjunsharmazetaris/zeppelin_pod_sync.git\"\ntarget_branch \u003d \"zeppelin_sync\"\ncommit_message \u003d \"Automated Zeppelin notebook commit\"\n\ntry:\n    # Clean repo dir if exists\n    if os.path.exists(repo_path):\n        os.system(f\"rm -rf {repo_path}\")\n\n    print(\"Cloning repo...\")\n    repo \u003d Repo.clone_from(remote_url, repo_path)\n\n    # Checkout or create target branch\n    if f\"origin/{target_branch}\" not in repo.git.branch(\u0027-r\u0027):\n        print(f\"Branch \u0027{target_branch}\u0027 doesn\u0027t exist remotely. Creating it locally...\")\n        new_branch \u003d repo.create_head(target_branch)\n        new_branch.checkout()\n        repo.git.push(\"--set-upstream\", \"origin\", target_branch)\n    else:\n        print(f\"Checking out branch \u0027{target_branch}\u0027...\")\n        repo.git.checkout(target_branch)\n\n    print(\"Copying notebooks...\")\n    os.system(f\u0027cp -r {notebook_dir}/* {repo_path}/\u0027)\n\n    print(\"Files in repo after copy:\")\n    print(os.listdir(repo_path))\n\n    repo.git.add(A\u003dTrue)\n\n    if repo.is_dirty():\n        repo.index.commit(commit_message)\n        print(\"Changes committed.\")\n\n        # Pull with rebase before pushing\n        try:\n            print(\"Pulling latest changes with rebase...\")\n            repo.git.pull(\u0027--rebase\u0027, \u0027origin\u0027, target_branch)\n        except GitCommandError as e:\n            print(f\"⚠️ Pull with rebase failed: {e}\")\n            raise\n\n        print(\"Pushing changes to remote...\")\n        push_results \u003d repo.remote(name\u003d\u0027origin\u0027).push(refspec\u003df\u0027{target_branch}:{target_branch}\u0027)\n        print(push_results)\n        print(\"✅ Changes pushed successfully.\")\n    else:\n        print(\"✅ No changes to commit.\")\n\nexcept GitCommandError as e:\n    print(f\"❌ Git command error: {e}\")\nexcept Exception as e:\n    print(f\"❌ Unexpected error: {e}\")\n",
