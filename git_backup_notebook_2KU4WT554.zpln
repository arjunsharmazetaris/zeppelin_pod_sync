    {
      "text": "import subprocess\r\nimport os\r\nimport datetime\r\n\r\n# GitHub token and repo details\r\nGIT_TOKEN \u003d \"#################\"  # \u003c-- Replace this securely\r\nGIT_REPO_URL \u003d f\"https://arjunsharmazetaris:{GIT_TOKEN}@github.com/arjunsharmazetaris/zeppelin_pod_sync.git\"\r\nGIT_BRANCH \u003d \"zeppelin_sync\"\r\nlocal_repo_path \u003d \"/tmp/repo\"\r\n\r\ntry:\r\n    # Clean up existing clone\r\n    subprocess.run(f\"rm -rf {local_repo_path}\", shell\u003dTrue, check\u003dTrue)\r\n\r\n    # Clone the specific branch of the repo\r\n    subprocess.run(f\"git clone --single-branch --branch {GIT_BRANCH} {GIT_REPO_URL} {local_repo_path}\", shell\u003dTrue, check\u003dTrue)\r\n\r\n    # Copy the backup file into the repo directory\r\n    subprocess.run(f\"cp /tmp/zeppelin_backup.tar.gz {local_repo_path}/\", shell\u003dTrue, check\u003dTrue)\r\n\r\n    # Move into the local repo directory\r\n    os.chdir(local_repo_path)\r\n\r\n    # Configure Git user if not already set\r\n    subprocess.run(\u0027git config user.email \"zeppelin@zetaris.com\"\u0027, shell\u003dTrue, check\u003dTrue)\r\n    subprocess.run(\u0027git config user.name \"zeppelin\"\u0027, shell\u003dTrue, check\u003dTrue)\r\n\r\n    # Add, commit, and push the backup\r\n    subprocess.run(\"git add .\", shell\u003dTrue, check\u003dTrue)\r\n    commit_message \u003d f\"Zeppelin notebook backup on {datetime.datetime.now().isoformat()}\"\r\n    subprocess.run(f\u0027git commit -m \"{commit_message}\"\u0027, shell\u003dTrue, check\u003dTrue)\r\n    subprocess.run(f\"git push origin {GIT_BRANCH}\", shell\u003dTrue, check\u003dTrue)\r\n\r\n    print(\"✅ Backup pushed to GitHub successfully\")\r\n\r\nexcept subprocess.CalledProcessError as e:\r\n    print(f\"❌ Git operation failed: {e}\")\r\n",
      "user": "ARJUN.SHARMA@ZETARIS.COM",
      "dateUpdated": "2025-05-20 15:02:59.598",
