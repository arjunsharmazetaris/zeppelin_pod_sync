      "text": "%python\nimport os\nimport re\nfrom git import Repo, GitCommandError\n\ndef load_env_file(path):\n    with open(path) as f:\n        for line in f:\n            # Skip empty lines and comments\n            if line.strip() \u003d\u003d \u0027\u0027 or line.strip().startswith(\u0027#\u0027):\n                continue\n            key, value \u003d line.strip().split(\u0027\u003d\u0027, 1)\n            os.environ[key] \u003d value\n\n# Load from /tmp/.env\nload_env_file(\"/tmp/.env\")\n\n\n\nnotebook_dir \u003d \"/home/zetaris/zeppelin/notebooks\"\nrepo_path \u003d \"/tmp/zeppelin_sync_repo\"\n\nGIT_TOKEN \u003d os.getenv(\"GIT_TOKEN\")\nif not GIT_TOKEN:\n    raise ValueError(\"❌ GIT_TOKEN not set in environment.\")\n\nremote_url \u003d f\"https://arjunsharmazetaris:{GIT_TOKEN}@github.com/arjunsharmazetaris/zeppelin_pod_sync.git\"\ntarget_branch \u003d \"zeppelin_sync\"\ncommit_message \u003d \"🔐 Auto-scrubbed sync commit (secrets redacted)\"\n\n# Pattern to detect common GitHub tokens\nsecret_pattern \u003d re.compile(r\"(gh[pus]_[A-Za-z0-9]{36,})|github_pat_[A-Za-z0-9_]{20,}\")\n\ndef scrub_secrets_in_file(filepath):\n    with open(filepath, \"r\") as f:\n        content \u003d f.read()\n\n    scrubbed \u003d secret_pattern.sub(\"\u003cREDACTED\u003e\", content)\n\n    if content !\u003d scrubbed:\n        print(f\"🚨 Secrets found and redacted in: {filepath}\")\n\n    with open(filepath, \"w\") as f:\n        f.write(scrubbed)\n\ndef scrub_all_zpln_files(path):\n    for root, _, files in os.walk(path):\n        for file in files:\n            if file.endswith(\".zpln\"):\n                scrub_secrets_in_file(os.path.join(root, file))\n\ntry:\n    if os.path.exists(repo_path):\n        os.system(f\"rm -rf {repo_path}\")\n\n    print(\"📥 Cloning fresh repo...\")\n    repo \u003d Repo.clone_from(remote_url, repo_path)\n\n    print(f\"📌 Checking out \u0027{target_branch}\u0027...\")\n    repo.git.checkout(\u0027-B\u0027, target_branch)\n\n    print(\"🧹 Cleaning old files from repo...\")\n    for item in os.listdir(repo_path):\n        if item not in [\u0027.git\u0027]:\n            os.system(f\u0027rm -rf \"{os.path.join(repo_path, item)}\"\u0027)\n\n    print(\"📂 Copying notebooks...\")\n    os.system(f\u0027cp -r {notebook_dir}/* {repo_path}/\u0027)\n\n    print(\"🔎 Scrubbing secrets from .zpln files...\")\n    scrub_all_zpln_files(repo_path)\n\n    repo.git.add(A\u003dTrue)\n    if repo.is_dirty():\n        repo.index.commit(commit_message)\n        print(\"✅ Changes committed.\")\n    else:\n        print(\"✅ No changes detected.\")\n\n    print(\"📤 Force pushing to remote...\")\n    repo.git.push(\u0027--force\u0027, \u0027origin\u0027, target_branch)\n    print(\"✅ Push complete.\")\n\nexcept GitCommandError as e:\n    print(f\"❌ Git command error: {e}\")\nexcept Exception as e:\n    print(f\"❌ Unexpected error: {e}\")\n",
