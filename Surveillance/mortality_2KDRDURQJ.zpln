    {
      "text": "%spark.ipyspark\n%matplotlib inline\n\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport plotly.express as px\n\n# mortality dataset\nmortality_df \u003d mortality.toPandas()\n\ndf_filtered \u003d mortality_df[(mortality_df[\u0027metric\u0027] \u003d\u003d \u0027Number\u0027)][[\u0027location\u0027, \u0027val\u0027]]\n\n# Create a dictionary mapping locations to their corresponding values\nlocation_values \u003d df_filtered.groupby(\u0027location\u0027)[\u0027val\u0027].mean().to_dict()\n\n# Create a world map using Plotly Express\nfig \u003d px.choropleth(\n    df_filtered,\n    locations\u003d\"location\",\n    locationmode\u003d\"country names\",\n    color\u003d\"val\",\n    hover_name\u003d\"location\",\n    title\u003d\"World Map Heatmap by Mortality\",\n    color_continuous_scale\u003dpx.colors.sequential.YlOrRd\n)\n\nfig.show()",
      "user": "anonymous",
      "dateUpdated": "2024-11-08 04:04:05.697",
