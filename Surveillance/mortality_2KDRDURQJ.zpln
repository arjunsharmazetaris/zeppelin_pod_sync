      "text": "import pandas as pd\nimport io, requests\nimport matplotlib.pyplot as plt\n\n# Define custom headers to mimic a browser request\nheaders \u003d {\n    \u0027User-Agent\u0027: \u0027Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/108.0.0.0 Safari/537.36\u0027\n}\n\n# Fetch the data using the custom headers\nurl \u003d \"https://ourworldindata.org/grapher/death-rates-through-the-20th-century.csv\"\nresponse \u003d requests.get(url, headers\u003dheaders) \ncsv_data \u003d io.StringIO(response.content.decode(\u0027utf-8\u0027))  \ndf \u003d pd.read_csv(csv_data)\n\n# Fetch the metadata\nmetadata_url \u003d \"https://ourworldindata.org/grapher/death-rates-through-the-20th-century.metadata.json?v\u003d1\u0026csvType\u003dfull\u0026useColumnShortNames\u003dtrue\"\nmetadata \u003d requests.get(metadata_url, headers\u003dheaders).json() # Use headers here as well",
