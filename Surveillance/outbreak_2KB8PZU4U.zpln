    {
      "text": "%spark.ipyspark\n\n# patients dataset\npatients \u003d spark_patients_df.toPandas()\n\n# Group data by location and count the number of records in each area\nlocation_counts \u003d patients.groupby([\u0027lat\u0027, \u0027lon\u0027])[\u0027patientid\u0027].count().reset_index()\n\n# Create a list of coordinates and intensity values for the heatmap\nheatmap_data \u003d [[row[\u0027lat\u0027], row[\u0027lon\u0027], row[\u0027patientid\u0027]] for index, row in location_counts.iterrows()]\n\n# Create a map centered around the mean latitude and longitude\nmap_center_lat \u003d patients[\u0027lat\u0027].mean()\nmap_center_lon \u003d patients[\u0027lon\u0027].mean()\nmy_map \u003d folium.Map(location\u003d[map_center_lat, map_center_lon], zoom_start\u003d10)\n\n# Add a heatmap layer to the map\nHeatMap(heatmap_data, radius\u003d15).add_to(my_map)\n\n# Display the map\nmy_map",
      "user": "anonymous",
      "dateUpdated": "2024-10-31 02:24:48.636",
