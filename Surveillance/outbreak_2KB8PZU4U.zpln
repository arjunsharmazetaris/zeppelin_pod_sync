    {
      "text": "%spark.ipyspark\n\nimport pandas as pd\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# correlations between disorders and findings\nconditions \u003d spark_conditions_df.toPandas()\ncondition_counts \u003d conditions[\u0027description\u0027].value_counts()\n\n# Create a pivot table to show the count of each condition per patient\n# Replace \u0027PATIENT_ID\u0027 with the actual column name for patient IDs in your data\npatient_condition_matrix \u003d conditions.groupby([\u0027patient\u0027, \u0027description\u0027])[\u0027description\u0027].count().unstack().fillna(0)\n\n# Create a correlation matrix to find relationships between conditions\ncorrelation_matrix \u003d patient_condition_matrix.corr()\n\n# Use seaborn to create a heatmap of the correlation matrix\nplt.figure(figsize\u003d(15, 10))  # Adjust figure size as needed\nsns.heatmap(correlation_matrix, annot\u003dTrue, cmap\u003d\u0027coolwarm\u0027, fmt\u003d\".2f\")\nplt.title(\u0027Correlation Matrix of Conditions\u0027)\nplt.show()\n\n# Example: Grouping viral conditions (You\u0027ll need to adjust this based on your data)\nviral_keywords \u003d [\u0027virus\u0027, \u0027viral\u0027, \u0027influenza\u0027, \u0027covid\u0027]  # Add more relevant keywords\n\ndef is_viral(condition_description):\n  for keyword in viral_keywords:\n    if keyword in condition_description.lower():\n      return True\n  return False\n\nconditions[\u0027IsViral\u0027] \u003d conditions[\u0027description\u0027].apply(is_viral)\n\n",
      "user": "anonymous",
