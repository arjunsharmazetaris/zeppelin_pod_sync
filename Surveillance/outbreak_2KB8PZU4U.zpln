      "text": "%spark.ipyspark\n\n# rfm prediction of outbreaks\n\n# convert conditions to dataframe\nconditions \u003d spark_conditions_df.toPandas()\n\n# Convert the \u0027START\u0027 column to datetime objects\nconditions[\u0027start\u0027] \u003d pd.to_datetime(conditions[\u0027start\u0027])\n\n# Group by \u0027DESCRIPTION\u0027 and \u0027START\u0027 (month and year) to count occurrences\ncondition_counts \u003d conditions.groupby([\u0027description\u0027, pd.Grouper(key\u003d\u0027start\u0027, freq\u003d\u0027ME\u0027)])[\u0027start\u0027].count().unstack()\n\n# Calculate the rolling average (e.g., 3-month rolling average) for each condition\nrolling_average \u003d condition_counts.rolling(window\u003d3, center\u003dTrue).mean()\n\n# Identify potential outbreaks based on significant increases in frequency\nthreshold \u003d 100  # Define threshold for a significant increase\n\npotential_outbreaks \u003d rolling_average[rolling_average \u003e rolling_average.mean() + threshold]\n\n# Print the potential outbreaks\nprint(\"Potential Outbreaks:\")\n#print(potential_outbreaks)\n\n# Visualize the trends\nplt.figure(figsize\u003d(15, 8))\nfor condition in condition_counts.columns:\n  plt.plot(condition_counts.index, condition_counts[condition], label\u003dcondition)\nplt.xlabel(\u0027Month\u0027)\nplt.ylabel(\u0027Number of Patients\u0027)\nplt.title(\u0027Trend of Medical Conditions Over Time\u0027)\n#plt.legend(loc\u003d\u0027upper left\u0027)\n#plt.show()\nz.show(plt)\n",
