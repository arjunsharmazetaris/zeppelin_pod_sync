    {
      "text": "%spark.ipyspark\n\n# convert conditions to dataframe\nconditions \u003d spark_conditions_df.toPandas()\n\n# Assuming \u0027conditions\u0027 DataFrame is loaded and \u0027START\u0027 is a datetime column\nconditions[\u0027start\u0027] \u003d pd.to_datetime(conditions[\u0027start\u0027])\n\n# Group by \u0027DESCRIPTION\u0027 and \u0027START\u0027 (month) to count occurrences\ncondition_counts \u003d conditions.groupby([\u0027description\u0027, pd.Grouper(key\u003d\u0027start\u0027, freq\u003d\u0027ME\u0027)])[\u0027start\u0027].count().unstack()\n\n# Fill NaN with 0\ncondition_counts \u003d condition_counts.fillna(0)\n\n# Calculate the rolling average (e.g., 3-month rolling average) for each condition\nrolling_average \u003d condition_counts.rolling(window\u003d3, center\u003dTrue).mean()\n\n# Calculate the difference between the current month\u0027s count and the rolling average\ndifference \u003d condition_counts - rolling_average\n\n# Define a threshold for detecting outbreaks (e.g., a significant increase above the rolling average)\nthreshold \u003d 10  # Adjust as needed based on your data\n\n# Identify conditions with a significant increase above the rolling average\noutbreaks \u003d difference[difference \u003e threshold]\n\n# Plot the conditions that are on the rise above the threshold\nplt.figure(figsize\u003d(15, 8))\nfor condition in outbreaks.columns:\n  if condition in outbreaks.columns:\n    plt.plot(outbreaks.index, outbreaks[condition], label\u003dcondition)\nplt.xlabel(\u0027Month\u0027)\nplt.ylabel(\u0027Difference from Rolling Average\u0027)\nplt.title(\u0027Conditions with Significant Increase from Rolling Average\u0027)\nplt.legend(loc\u003d\u0027upper left\u0027)\nplt.show()",
      "user": "anonymous",
      "dateUpdated": "2024-10-31 02:36:26.771",
      "progress": 0,
