    {
      "text": "%spark.ipyspark\n\nimport pandas as pd\nimport hvplot.pandas  # Import hvplot\n\n\n# convert conditions to a DataFrame\nconditions \u003d spark_conditions_df.toPandas()\n\n# Assuming \u0027conditions\u0027 DataFrame is loaded and \u0027START\u0027 is a datetime column\nconditions[\u0027start\u0027] \u003d pd.to_datetime(conditions[\u0027start\u0027])\n\n# Group by \u0027DESCRIPTION\u0027 and year to count occurrences\ncondition_counts_by_year \u003d conditions.groupby([\u0027description\u0027, conditions[\u0027start\u0027].dt.year])[\u0027start\u0027].count().unstack()\n\n# Fill NaN with 0\ncondition_counts_by_year \u003d condition_counts_by_year.fillna(0)\n\n# Find the four most prevalent conditions\ntop_four_conditions \u003d condition_counts_by_year.sum(axis\u003d1).nlargest(4).index\n\n# Create a new DataFrame with only the top four conditions\ntop_four_df \u003d condition_counts_by_year.loc[top_four_conditions]\n\n# Transpose the DataFrame for plotting\ntop_four_df \u003d top_four_df.T\n\n# Plot the top four conditions over time\ntop_four_df.hvplot(\n    xlabel\u003d\u0027Year\u0027,\n    ylabel\u003d\u0027Prevalence\u0027,\n    title\u003d\u0027Most Prevalent Conditions\u0027,\n    width\u003d800,\n    height\u003d500,\n)",
      "user": "anonymous",
