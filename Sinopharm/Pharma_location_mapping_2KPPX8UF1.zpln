    {
      "text": "import matplotlib.pyplot as plt\n\ntest \u003d test.iloc[window_size:].copy() #homogenize test and actuals\nX_test, y_test \u003d np.array(X_test), np.array(y_test[:len(X_test)])  # Ensure y_test matches X_test length\n\n\n# Merge predictions back to test data\ntest[\u0027predicted_sales\u0027] \u003d predictions.flatten()\ntest[\u0027actual_sales\u0027] \u003d y_test_actual.flatten()\npredictions \u003d model.predict(X_test)\npredictions \u003d scaler.inverse_transform(predictions)\n\ny_test_actual \u003d scaler.inverse_transform(y_test.reshape(-1, 1))  # Ensure shape matches\n\n\n# Group by store\nstores_list \u003d test[\u0027store_id\u0027].unique()\n\n# Plot Actual vs. Predicted Sales for each store\nplt.figure(figsize\u003d(12, 6))\n\nfor store in stores_list:\n    store_data \u003d test[test[\u0027store_id\u0027] \u003d\u003d store]\n    \nfor store in stores_list:\n    store_data \u003d test[test[\u0027store_id\u0027] \u003d\u003d store]\n    \n    if len(store_data) \u003e 0:\n        plt.figure(figsize\u003d(10, 5))\n        plt.plot(store_data[\u0027date\u0027], store_data[\u0027actual_sales\u0027], label\u003d\u0027Actual Sales\u0027, linestyle\u003d\u0027solid\u0027)\n        plt.plot(store_data[\u0027date\u0027], store_data[\u0027predicted_sales\u0027], label\u003d\u0027Predicted Sales\u0027, linestyle\u003d\u0027dashed\u0027)\n\n        plt.xlabel(\"Date\")\n        plt.ylabel(\"Sales\")\n        plt.title(f\"Actual vs Predicted Sales for {store}\")\n        plt.legend()\n        plt.xticks(rotation\u003d45)\n        plt.grid()\n        plt.show()\n        z.show(plt)\n\n",
