    {
      "text": "\n# Forecasting Future Demand\nfuture_dates \u003d pd.date_range(start\u003ddf[\u0027date\u0027].max(), periods\u003d90, freq\u003d\u0027D\u0027)\nfuture_df \u003d pd.DataFrame(index\u003dfuture_dates)\nfuture_df[\u0027month\u0027] \u003d future_df.index.month\nfuture_df[\u0027day_of_week\u0027] \u003d future_df.index.dayofweek\nfuture_df[\u0027sin_month\u0027] \u003d np.sin(2 * np.pi * future_df[\u0027month\u0027] / 12)\nfuture_df[\u0027cos_month\u0027] \u003d np.cos(2 * np.pi * future_df[\u0027month\u0027] / 12)\nfuture_df[\u0027sin_dow\u0027] \u003d np.sin(2 * np.pi * future_df[\u0027day_of_week\u0027] / 7)\nfuture_df[\u0027cos_dow\u0027] \u003d np.cos(2 * np.pi * future_df[\u0027day_of_week\u0027] / 7)\n\nfuture_features \u003d future_df[[\u0027sin_month\u0027, \u0027cos_month\u0027, \u0027sin_dow\u0027, \u0027cos_dow\u0027]].values\nfuture_features \u003d scaler.transform(future_features)\nfuture_predictions \u003d model.predict(future_features)\nfuture_predictions \u003d scaler.inverse_transform(future_predictions)\n\n# Plot Future Forecast\nplt.figure(figsize\u003d(10, 5))\nplt.plot(future_dates, future_predictions, label\u003d\u0027Predicted Future Sales\u0027, linestyle\u003d\u0027dashed\u0027)\nplt.title(\"Future SKU Demand Forecast\")\nplt.xlabel(\"Date\")\nplt.ylabel(\"Sales\")\nplt.legend()\nplt.show()",
