    {
      "text": "import pandas as pd\n\napi_url \u003d \u0027https://api.saas.enterprise.zetaris.com/\u0027\ndata_zetaris \u003d run_sql(\u0027select * from Demand.demand_data\u0027, api_url)\nheaders \u003d data_zetaris[\u0027headers\u0027]\nrows \u003d data_zetaris[\u0027data\u0027]\nrecords \u003d [{headers[i]: row[i] for i in range(len(headers))} for row in rows]\nupdated_data \u003d {\u0027data\u0027: records}\ndf \u003d pd.DataFrame(updated_data[\u0027data\u0027])\ndf \u003d df[[\"date\", \"sku_id\", \"store_id\", \"sales\"]]\ndf \u003d df.dropna()\ndf[\"combined\"] \u003d (\n    \"Title: \" + df.store_id.str.strip() + \"; Content: \" + df.sales.str.strip()\n)",
